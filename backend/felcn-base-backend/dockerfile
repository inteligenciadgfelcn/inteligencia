# ----------- BUILD -----------
FROM node:22-alpine AS build
WORKDIR /home/node/app

COPY package*.json ./
RUN npm ci --prefer-offline --no-audit

COPY . .
RUN node --run build


# ----------- PROD DEPS -----------
FROM node:22-alpine AS prod-deps
WORKDIR /home/node/app

COPY package*.json ./
RUN npm ci --omit=dev --prefer-offline --no-audit


# ----------- FINAL -----------
FROM node:22-slim AS app
WORKDIR /home/node/app

# Chromium para Puppeteer (Debian slim usa glibc — compatible con Chrome)
#
# NOTA PARA EL DEVELOPER — si el build falla acá con
# "E: Version 'X.X.X.X' for 'chromium' was not found":
# bookworm-security rota los paquetes viejos en cuestión de días
# (147.0.7727.137 y luego 150.0.7871.114 ya dejaron de existir ahí, cada
# uno rompió el build al día siguiente de fijarlo). Por eso NO se fija
# versión exacta a propósito — se instala siempre la última disponible.
#
# Si algún día vuelve a fallar (o el PDF/Puppeteer empieza a crashear con
# SIGILL, que ya pasó una vez con una 150.x vieja), diagnosticar así:
#   1. Ver qué versiones hay disponibles ahora mismo:
#        docker run --rm node:22-slim sh -c \
#          "apt-get update -qq && apt-cache madison chromium"
#   2. Probar una versión de forma aislada ANTES de fijarla en este archivo:
#        docker run --rm node:22-slim sh -c \
#          "apt-get update -qq && apt-get install -y chromium=<version> \
#           chromium-common=<version> ca-certificates -qq && \
#           chromium --headless --no-sandbox --disable-gpu \
#           --dump-dom about:blank"
#      Si crashea o no imprime "<html>...", esa versión está rota — probar
#      otra de la lista del paso 1.
#   3. Recién ahí, si hace falta fijar una versión buena, agregar
#      "=<version>" a chromium y chromium-common abajo.
#
# apt-mark hold congela lo instalado dentro de la imagen ya construida
# (no evita que el próximo build pida una versión que ya rotó).
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-common \
    fonts-noto \
    fonts-freefont-ttf \
    ca-certificates \
    && apt-mark hold chromium chromium-common \
    && rm -rf /var/lib/apt/lists/*

# Puppeteer usará el Chromium del sistema
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    NODE_ENV=production

# Crear carpeta de logs con permisos correctos
RUN mkdir -p /tmp/logs && chown -R node:node /tmp/logs /home/node

# Copiar archivos
COPY --from=prod-deps /home/node/app/node_modules ./node_modules
COPY --from=build /home/node/app/dist ./dist
COPY --from=build /home/node/app/src ./src

# metadata (opcional)
ARG CI_COMMIT_SHORT_SHA
ARG CI_COMMIT_MESSAGE
ARG CI_COMMIT_REF_NAME

ENV CI_COMMIT_SHORT_SHA=$CI_COMMIT_SHORT_SHA \
    CI_COMMIT_MESSAGE=$CI_COMMIT_MESSAGE \
    CI_COMMIT_REF_NAME=$CI_COMMIT_REF_NAME

USER node

EXPOSE 3000

CMD ["node", "dist/src/main"]
