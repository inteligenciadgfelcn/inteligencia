{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "root": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "**/model.conf",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "**/*.csv",
        "outDir": "dist/src"
      },
      {
        "include": "application/inteligencia/reportes/pdf/templates/**/*.hbs",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "application/inteligencia/reportes/assets/images/**/*.png",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}
