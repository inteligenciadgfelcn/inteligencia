<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Reporte de Persona Jurídica — Pérdida de Dominio</title>

  <style>
    :root {
      --celeste: #5f9fbd;
      --oscuro: #2e6680;
      --claro: #eaf5fb;
      --fondo: #f5fafd;
      --borde: #9ac9df;
      --texto: #181818;
      --gris: #777;
    }

    * { box-sizing: border-box; }

    @page {
      size: 216mm 330mm;
      margin: 6mm 8mm 7mm;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 9px;
      color: var(--texto);
      background: white;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .encabezado {
      display: grid;
      grid-template-columns: 42mm 1fr;
      align-items: center;
      min-height: 25mm;
      padding: 2mm;
      background: var(--fondo);
      break-inside: avoid;
    }

    .logos {
      display: flex;
      align-items: center;
      gap: 2mm;
    }

    .logo {
      width: 18mm;
      height: 18mm;
      object-fit: contain;
    }

    .separador-logo {
      width: 1px;
      height: 18mm;
      background: var(--celeste);
    }

    .encabezado-texto {
      min-width: 0;
      padding: 0 2mm;
      text-align: center;
    }

    .titulo-institucion {
      margin: 0;
      color: var(--celeste);
      font-size: 16px;
      font-weight: 500;
      line-height: 1.15;
    }

    .titulo-reporte {
      margin: 2mm 0 0;
      font-size: 10px;
    }

    .cuerpo {
      display: grid;
      grid-template-columns: 38% 62%;
      align-items: stretch;
    }

    .columna-izquierda {
      min-width: 0;
      padding: 2mm 2.5mm 4mm;
      background: var(--fondo);
      border-right: 2px solid var(--celeste);
    }

    .columna-derecha {
      min-width: 0;
      padding: 2mm 0 4mm 3mm;
    }

    .titulo-accion {
      margin: 0 0 2mm;
      color: var(--celeste);
      font-size: 12px;
      break-after: avoid;
    }

    .fila-doble {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4mm;
      margin-bottom: 2.3mm;
      break-inside: avoid;
    }

    .campo, .campo-completo {
      min-width: 0;
      text-align: center;
    }

    .campo-completo {
      margin-bottom: 2.3mm;
      break-inside: avoid;
    }

    .campo-valor {
      min-height: 5mm;
      padding: 0 1mm 0.7mm;
      border-bottom: 1px solid var(--borde);
      font-size: 9.7px;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .campo-etiqueta {
      padding-top: 0.5mm;
      color: var(--celeste);
      font-size: 6.2px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .seccion { margin-bottom: 3mm; }

    .titulo-seccion {
      margin: 2mm 0 1mm;
      color: var(--oscuro);
      font-size: 9px;
      text-transform: uppercase;
      break-after: avoid;
    }

    .dato {
      margin-bottom: 0.7mm;
      font-size: 8.5px;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .lista {
      margin: 0;
      padding-left: 5mm;
    }

    .lista li {
      margin-bottom: 0.7mm;
      overflow-wrap: anywhere;
    }

    .sin-registros {
      color: var(--gris);
      font-style: italic;
    }

    .cabecera-novedad {
      padding: 0 2mm 3mm;
      border-bottom: 2px solid var(--celeste);
      break-inside: avoid;
    }

    .novedad-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.8fr 0.9fr;
      gap: 3mm;
      align-items: end;
    }

    .afectacion {
      margin-top: 2mm;
      text-align: center;
      break-inside: avoid;
    }

    .afectacion-valor {
      padding: 0 1mm 0.8mm;
      border-bottom: 1px solid var(--borde);
      font-size: 10px;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .afectacion-etiqueta {
      margin-top: 0.5mm;
      color: var(--celeste);
      font-size: 6.2px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .detalle-empresa { padding: 0 2mm; }

    .vinculo-empresa {
      margin: 1mm 0 2mm;
      padding: 1mm 1.2mm;
      background: var(--claro);
      border-left: 3px solid var(--celeste);
      color: var(--oscuro);
      font-size: 8px;
    }

    .datos-bien-compactos {
      margin: 1mm 0 2mm;
      font-size: 8px;
      line-height: 1.2;
    }

    .dato-bien-compacto {
      margin: 0 0 0.5mm;
      overflow-wrap: anywhere;
      white-space: normal;
      line-height: 1.2;
    }

    .tabla-detalle {
      width: 100%;
      margin: 1mm 0 2mm;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 8px;
      line-height: 1.25;
    }

    .tabla-detalle th,
    .tabla-detalle td {
      padding: 1mm;
      border-bottom: 1px solid #ddd;
      text-align: left;
      vertical-align: top;
      overflow-wrap: anywhere;
    }

    .tabla-detalle th {
      color: var(--oscuro);
      background: var(--fondo);
    }

    .tabla-detalle thead {
      display: table-header-group;
    }

    .tabla-detalle tr { break-inside: avoid; }

    .muestrario { padding: 2mm; }

    .imagen-empresa {
      display: block;
      max-width: 100%;
      max-height: 40mm;
      margin: 1mm auto;
      object-fit: contain;
    }

    .ubicacion-contenido {
      display: grid;
      grid-template-columns: 43mm minmax(0, 1fr);
      gap: 3mm;
      align-items: start;
      break-inside: avoid;
    }

    .ubicacion-mapa img {
      display: block;
      width: 43mm;
      height: 43mm;
      object-fit: contain;
      border: 1px solid #ddd;
    }

    .mapa-atribucion {
      margin-top: 1mm;
      font-size: 6px;
      text-align: center;
    }

    .ubicacion-detalle {
      min-width: 0;
      font-size: 8px;
      overflow-wrap: anywhere;
    }

    .enlace-ubicacion {
      margin-top: 2mm;
      font-size: 8px;
    }

    .pie {
      display: flex;
      align-items: center;
      gap: 2mm;
      margin-top: 4mm;
      font-size: 8px;
      break-inside: avoid;
    }

    .pie-linea {
      flex: 1;
      border-top: 1px dashed var(--borde);
    }
  </style>
</head>

<body>
  <main>
    <header class="encabezado">
      <div class="logos">
        {{#if institucional}}
          <img class="logo" src="{{institucional}}" alt="Logo institucional" />
        {{/if}}
        <span class="separador-logo"></span>
        {{#if escudo}}
          <img class="logo" src="{{escudo}}" alt="Escudo institucional" />
        {{/if}}
      </div>

      <div class="encabezado-texto">
        <h1 class="titulo-institucion">
          Grupo de Investigación y Análisis Económico Financiero
        </h1>
        <p class="titulo-reporte">
          Reporte N.º
          <strong>{{reporte.numero}}/{{reporte.gestion}}</strong>
          — División Regional del GIAEF {{reporte.divisionRegional}}
        </p>
      </div>
    </header>

    <section class="cuerpo">
      <aside class="columna-izquierda">
        <h2 class="titulo-accion">Pérdida de Dominio</h2>

        <div class="fila-doble">
          <div class="campo">
            <div class="campo-valor">{{accion.nombreCaso}}</div>
            <div class="campo-etiqueta">Nombre del caso</div>
          </div>
          <div class="campo">
            <div class="campo-valor">{{accion.fechaInicio}}</div>
            <div class="campo-etiqueta">Fecha inicio</div>
          </div>
        </div>

        <div class="fila-doble">
          <div class="campo">
            <div class="campo-valor">{{accion.numeroCasoFiscalia}}</div>
            <div class="campo-etiqueta">N.º caso Fiscalía</div>
          </div>
          <div class="campo">
            <div class="campo-valor">{{accion.numeroCasoGiaef}}</div>
            <div class="campo-etiqueta">N.º caso GIAEF</div>
          </div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.etapa}}</div>
          <div class="campo-etiqueta">Etapa</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.formaInicio}}</div>
          <div class="campo-etiqueta">Forma de inicio del caso</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.lugarInvestigacion}}</div>
          <div class="campo-etiqueta">Lugar donde se investiga el caso</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">
            {{#each accion.investigadores}}
              <div>{{this}}</div>
            {{else}}
              <div>Sin investigadores asignados.</div>
            {{/each}}
          </div>
          <div class="campo-etiqueta">Investigadores asignados al caso</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.fiscalAsignado}}</div>
          <div class="campo-etiqueta">Fiscal asignado al caso</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.controlJurisdiccional}}</div>
          <div class="campo-etiqueta">Control jurisdiccional</div>
        </div>

        <section class="seccion">
          <h2 class="titulo-seccion">Personas investigadas</h2>
          <ol class="lista">
            {{#each personasAfectadas}}
              <li>{{nombre}}</li>
            {{else}}
              <li class="sin-registros">Sin personas registradas.</li>
            {{/each}}
          </ol>
        </section>

        <section class="seccion">
          <h2 class="titulo-seccion">Datos de los casos precedentes</h2>

          {{#each delitoPrecedente}}
            <div class="seccion">
              <div class="dato"><strong>Caso N.º:</strong> {{numeroCaso}}</div>
              <div class="dato"><strong>Nombre:</strong> {{nombreCaso}}</div>
              <div class="dato"><strong>Fecha:</strong> {{fecha}}</div>
              <div class="dato"><strong>Unidad:</strong> {{unidad}}</div>
              <div class="dato"><strong>Lugar:</strong> {{lugar}}</div>
              <div class="dato">
                <strong>Personas implicadas:</strong> {{aprehendidos}}
              </div>
              <div class="dato">
                <strong>Bienes registrados:</strong> {{resumenBienes}}
              </div>
              <div class="dato">
                <strong>Total aproximado:</strong> {{costoTotalAproximado}}
              </div>
              <div class="dato">
                <strong>Total cuantificado:</strong> {{costoTotalCuantificado}}
              </div>
            </div>
          {{else}}
            <p class="sin-registros">Sin casos precedentes registrados.</p>
          {{/each}}
        </section>
      </aside>

      <article class="columna-derecha">
        <section class="cabecera-novedad">
          <div class="novedad-grid">
            <div class="campo">
              <div class="campo-valor">{{novedad.tipo}}</div>
              <div class="campo-etiqueta">Vínculo de la empresa</div>
            </div>
            <div class="campo">
              <div class="campo-valor">{{novedad.numero}}</div>
              <div class="campo-etiqueta">N.º novedad</div>
            </div>
            <div class="campo">
              <div class="campo-valor">{{novedad.fecha}}</div>
              <div class="campo-etiqueta">Fecha</div>
            </div>
          </div>

          <div class="afectacion">
  <div class="afectacion-valor">
    <strong>{{novedad.capitalSocialNumero}}</strong>
    {{#if novedad.capitalSocialLiteral}}
      ({{novedad.capitalSocialLiteral}})
    {{/if}}
  </div>

  <div class="afectacion-etiqueta">
    Capital social
  </div>
</div>
        </section>

        <section class="seccion detalle-empresa">
          <h2 class="titulo-seccion">
            Persona jurídica: {{empresa.nombre}}
          </h2>

          <div class="vinculo-empresa">
            <strong>Vínculo:</strong> {{empresa.vinculo}}
          </div>

          <div class="datos-bien-compactos">
            {{#each empresa.datos}}
              <div class="dato-bien-compacto">
                <strong>{{etiqueta}}:</strong> {{valor}}
              </div>
            {{/each}}

            <div class="dato-bien-compacto">
              <strong>Fecha de registro:</strong> {{empresa.fechaRegistro}}
            </div>

            <div class="dato-bien-compacto">
              <strong>Documento adjunto:</strong>
              {{#if empresa.tieneDocumento}}
                Registrado
              {{else}}
                Sin documento registrado
              {{/if}}
            </div>
          </div>

          <h2 class="titulo-seccion">Implicados de la empresa</h2>

          <table class="tabla-detalle">
            <thead>
              <tr>
                <th style="width: 7%;">N.º</th>
                <th style="width: 35%;">Nombre</th>
                <th style="width: 28%;">Tipo de implicado</th>
                <th style="width: 30%;">Documento</th>
              </tr>
            </thead>
            <tbody>
              {{#each empresa.implicados}}
                <tr>
                  <td>{{numero}}</td>
                  <td>{{nombre}}</td>
                  <td>{{tipoImplicado}}</td>
                  <td>
                    <div>{{tipoDocumento}}</div>
                    <div>{{numeroDocumento}}</div>
                  </td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="4">
                    Sin implicados activos registrados para esta empresa.
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section class="muestrario">
          <h2 class="titulo-seccion">Imagen de la empresa</h2>
          {{#if empresa.imagen}}
            <img
              class="imagen-empresa"
              src="{{empresa.imagen}}"
              alt="Imagen de {{empresa.nombre}}"
            />
          {{else}}
            <div class="sin-registros">Sin imagen registrada.</div>
          {{/if}}
        </section>

        <section class="seccion detalle-empresa">
          <h2 class="titulo-seccion">Ubicación de la empresa</h2>

          <div class="ubicacion-contenido">
            <div class="ubicacion-mapa">
              {{#if empresa.mapaImagen}}
                {{#if empresa.googleMapsUrl}}
                  <a href="{{empresa.googleMapsUrl}}" target="_blank" rel="noopener">
                    <img src="{{empresa.mapaImagen}}" alt="Ubicación de la empresa" />
                  </a>
                {{else}}
                  <img src="{{empresa.mapaImagen}}" alt="Ubicación de la empresa" />
                {{/if}}
                <div class="mapa-atribucion">© OpenStreetMap contributors</div>
              {{else}}
                <div class="sin-registros">
                  {{#if empresa.mapaError}}
                    {{empresa.mapaError}}
                  {{else}}
                    Mapa no disponible.
                  {{/if}}
                </div>
              {{/if}}
            </div>

            <div class="ubicacion-detalle">
              <div class="dato-bien-compacto">
                <strong>Dirección:</strong>
                {{#if empresa.direccion}}
                  {{empresa.direccion}}
                {{else}}
                  Sin dirección registrada
                {{/if}}
              </div>

              <table class="tabla-detalle">
                <tbody>
                  <tr>
                    <th>Latitud</th>
                    <td>
                      {{#if empresa.latitud includeZero=true}}
                        {{empresa.latitud}}
                      {{else}}
                        Sin registro
                      {{/if}}
                    </td>
                  </tr>
                  <tr>
                    <th>Longitud</th>
                    <td>
                      {{#if empresa.longitud includeZero=true}}
                        {{empresa.longitud}}
                      {{else}}
                        Sin registro
                      {{/if}}
                    </td>
                  </tr>
                </tbody>
              </table>

              {{#if empresa.googleMapsUrl}}
                <div class="enlace-ubicacion">
                  <a href="{{empresa.googleMapsUrl}}" target="_blank" rel="noopener">
                    Ver ubicación en Google Maps
                  </a>
                </div>
              {{/if}}
            </div>
          </div>
        </section>

        <footer class="pie">
          <div class="pie-linea"></div>
          <span>Fin de la transmisión</span>
        </footer>
      </article>
    </section>
  </main>
</body>
</html>