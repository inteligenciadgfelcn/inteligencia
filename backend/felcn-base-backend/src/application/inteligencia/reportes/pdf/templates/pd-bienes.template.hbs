<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Reporte de Bien — Pérdida de Dominio</title>

  <style>
    :root {
      --celeste: #5f9fbd;
      --oscuro: #2e6680;
      --claro: #eaf5fb;
      --fondo: #f5fafd;
      --borde: #9ac9df;
      --texto: #181818;
      --gris: #777;
    }

    * { box-sizing: border-box; }

    @page {
      size: 216mm 330mm;
      margin: 6mm 8mm 7mm;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 9px;
      color: var(--texto);
      background: white;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .encabezado {
      display: grid;
      grid-template-columns: 42mm 1fr;
      align-items: center;
      min-height: 25mm;
      padding: 2mm;
      background: var(--fondo);
      break-inside: avoid;
    }

    .logos {
      display: flex;
      align-items: center;
      gap: 2mm;
    }

    .logo {
      width: 18mm;
      height: 18mm;
      object-fit: contain;
    }

    .separador-logo {
      width: 1px;
      height: 18mm;
      background: var(--celeste);
    }

    .encabezado-texto {
      min-width: 0;
      padding: 0 2mm;
      text-align: center;
    }

    .titulo-institucion {
      margin: 0;
      color: var(--celeste);
      font-size: 16px;
      font-weight: 500;
      line-height: 1.15;
    }

    .titulo-reporte {
      margin: 2mm 0 0;
      font-size: 10px;
      line-height: 1.2;
    }

    .cuerpo {
      display: grid;
      grid-template-columns: 38% 62%;
      align-items: stretch;
    }

    .columna-izquierda {
      min-width: 0;
      padding: 2mm 2.5mm 4mm;
      background: var(--fondo);
      border-right: 2px solid var(--celeste);
    }

    .columna-derecha {
      min-width: 0;
      padding: 2mm 0 4mm 3mm;
    }

    .titulo-accion {
      margin: 0 0 2mm;
      color: var(--celeste);
      font-size: 12px;
      break-after: avoid;
    }

    .fila-doble {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4mm;
      margin-bottom: 2.3mm;
      break-inside: avoid;
    }

    .campo, .campo-completo {
      min-width: 0;
      text-align: center;
    }

    .campo-completo {
      margin-bottom: 2.3mm;
      break-inside: avoid;
    }

    .campo-valor {
      min-height: 5mm;
      padding: 0 1mm 0.7mm;
      border-bottom: 1px solid var(--borde);
      font-size: 9.7px;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .campo-etiqueta {
      padding-top: 0.5mm;
      color: var(--celeste);
      font-size: 6.2px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .seccion { margin-bottom: 3mm; }

    .titulo-seccion {
      margin: 2mm 0 1mm;
      color: var(--oscuro);
      font-size: 9px;
      text-transform: uppercase;
      break-after: avoid;
    }

    .texto {
      margin: 0;
      font-size: 8.5px;
      line-height: 1.3;
      text-align: justify;
      white-space: pre-line;
      overflow-wrap: anywhere;
      orphans: 3;
      widows: 3;
    }

    .dato {
      margin-bottom: 0.7mm;
      font-size: 8.5px;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .lista {
      margin: 0;
      padding-left: 5mm;
    }

    .lista li {
      margin-bottom: 1mm;
      overflow-wrap: anywhere;
    }

    .sin-registros {
      color: var(--gris);
      font-style: italic;
    }

    .cabecera-novedad {
      padding: 0 2mm 3mm;
      border-bottom: 2px solid var(--celeste);
      break-inside: avoid;
    }

    .novedad-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.8fr 0.9fr;
      gap: 3mm;
      align-items: end;
    }

    .afectacion {
      margin-top: 2mm;
      text-align: center;
    }

    .afectacion-valor {
      padding: 0 1mm 1mm;
      border-bottom: 1px solid var(--borde);
      font-size: 10px;
    }

    .afectacion-etiqueta {
      margin-top: 0.5mm;
      color: var(--celeste);
      font-size: 6.2px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .ultima-situacion {
      margin: 1mm 0 2mm;
      padding: 1.5mm;
      border-left: 3px solid var(--celeste);
      background: var(--claro);
      color: var(--oscuro);
      font-size: 8.5px;
      break-inside: avoid;
    }

    .datos-bien-compactos {
      margin: 1mm 0 2mm;
      font-size: 8px;
      line-height: 1.3;
    }

    .dato-bien-compacto {
  margin: 0 0 0.5mm;
  overflow-wrap: anywhere;
  white-space: normal;
  line-height: 1.2;
}

    .tabla-detalle {
      width: 100%;
      margin: 1mm 0 2mm;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 8px;
      line-height: 1.25;
    }

    .tabla-detalle th,
    .tabla-detalle td {
      padding: 1mm;
      border-bottom: 1px solid #ddd;
      text-align: left;
      vertical-align: top;
      overflow-wrap: anywhere;
    }

    .tabla-detalle th {
      color: var(--oscuro);
      background: var(--fondo);
    }

    .tabla-detalle thead {
      display: table-header-group;
    }

    .tabla-detalle tr {
      break-inside: avoid;
    }

    .tabla-detalle td div {
      margin-bottom: 0.6mm;
    }

    .fila-ultima td {
      background: var(--claro);
    }

    .muestrario { padding: 2mm 0; }

    .fotografias {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2mm;
      margin-top: 2mm;
    }

    .fotografia {
      min-width: 0;
      margin: 0;
      break-inside: avoid;
    }

    .fotografia-imagen {
      position: relative;
      height: 30mm;
      overflow: hidden;
      border: 1px solid var(--celeste);
      background: var(--claro);
    }

    .fotografia img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .numero-fotografia {
      position: absolute;
      top: 0;
      left: 0;
      padding: 1mm 2mm;
      background: #dfc313;
      font-weight: bold;
    }

    .foto-vacia {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: var(--gris);
      font-size: 7px;
    }

    .fotografia figcaption {
      margin-top: 1mm;
      font-size: 7px;
      overflow-wrap: anywhere;
    }

    .ubicacion-contenido {
      display: grid;
      grid-template-columns: 43mm minmax(0, 1fr);
      gap: 3mm;
      align-items: start;
      break-inside: avoid;
    }

    .ubicacion-mapa img {
      display: block;
      width: 43mm;
      height: 43mm;
      object-fit: contain;
      border: 1px solid #ddd;
    }

    .mapa-atribucion {
      margin-top: 1mm;
      font-size: 6px;
      text-align: center;
    }

    .ubicacion-detalle {
      min-width: 0;
      font-size: 8px;
      overflow-wrap: anywhere;
    }

    .enlace-ubicacion {
      margin-top: 2mm;
      font-size: 8px;
    }

    .pie {
      display: flex;
      align-items: center;
      gap: 2mm;
      margin-top: 4mm;
      font-size: 8px;
      break-inside: avoid;
    }

    .pie-linea {
      flex: 1;
      border-top: 1px dashed var(--borde);
    }
  </style>
</head>

<body>
  <main>
    <header class="encabezado">
      <div class="logos">
        {{#if institucional}}
          <img class="logo" src="{{institucional}}" alt="Logo institucional" />
        {{/if}}
        <span class="separador-logo"></span>
        {{#if escudo}}
          <img class="logo" src="{{escudo}}" alt="Escudo institucional" />
        {{/if}}
      </div>

      <div class="encabezado-texto">
        <h1 class="titulo-institucion">
          Grupo de Investigación y Análisis Económico Financiero
        </h1>
        <p class="titulo-reporte">
          Reporte N.º
          <strong>{{reporte.numero}}/{{reporte.gestion}}</strong>
          — División Regional del GIAEF {{reporte.divisionRegional}}
        </p>
      </div>
    </header>

    <section class="cuerpo">
      <aside class="columna-izquierda">
        <h2 class="titulo-accion">Pérdida de Dominio</h2>

        <div class="fila-doble">
          <div class="campo">
            <div class="campo-valor">{{accion.nombreCaso}}</div>
            <div class="campo-etiqueta">Nombre del caso</div>
          </div>
          <div class="campo">
            <div class="campo-valor">{{accion.fechaInicio}}</div>
            <div class="campo-etiqueta">Fecha inicio</div>
          </div>
        </div>

        <div class="fila-doble">
          <div class="campo">
            <div class="campo-valor">{{accion.numeroCasoFiscalia}}</div>
            <div class="campo-etiqueta">N.º caso Fiscalía</div>
          </div>
          <div class="campo">
            <div class="campo-valor">{{accion.numeroCasoGiaef}}</div>
            <div class="campo-etiqueta">N.º caso GIAEF</div>
          </div>
        </div>

          <div class="campo-completo">
            <div class="campo-valor">{{accion.etapa}}</div>
            <div class="campo-etiqueta">Etapa</div>
          </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.formaInicio}}</div>
          <div class="campo-etiqueta">Forma de inicio del caso</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.lugarInvestigacion}}</div>
          <div class="campo-etiqueta">Lugar donde se investiga el caso</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">
            {{#each accion.investigadores}}
              <div>{{this}}</div>
            {{else}}
              <div>Sin investigadores asignados.</div>
            {{/each}}
          </div>
          <div class="campo-etiqueta">Investigadores asignados al caso</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.fiscalAsignado}}</div>
          <div class="campo-etiqueta">Fiscal asignado al caso</div>
        </div>

        <div class="campo-completo">
          <div class="campo-valor">{{accion.controlJurisdiccional}}</div>
          <div class="campo-etiqueta">Control jurisdiccional</div>
        </div>

        <section class="seccion">
          <h2 class="titulo-seccion">Personas investigadas en el caso</h2>
          <ol class="lista">
            {{#each personasAfectadas}}
              <li>{{nombre}}</li>
            {{else}}
              <li class="sin-registros">
                Sin personas investigadas registradas.
              </li>
            {{/each}}
          </ol>
        </section>

        <section class="seccion">
          <h2 class="titulo-seccion">Datos de los casos precedentes</h2>

          {{#each delitoPrecedente}}
            <div class="seccion">
              <div class="dato"><strong>Caso N.º:</strong> {{numeroCaso}}</div>
              <div class="dato"><strong>Nombre:</strong> {{nombreCaso}}</div>
              <div class="dato"><strong>Fecha:</strong> {{fecha}}</div>
              <div class="dato"><strong>Unidad:</strong> {{unidad}}</div>
              <div class="dato"><strong>Lugar:</strong> {{lugar}}</div>
              <div class="dato">
                <strong>Personas implicadas:</strong> {{aprehendidos}}
              </div>
              <div class="dato">
                <strong>Bienes registrados:</strong> {{resumenBienes}}
              </div>
              <div class="dato">
                <strong>Total aproximado:</strong> {{costoTotalAproximado}}
              </div>
              <div class="dato">
                <strong>Total cuantificado:</strong> {{costoTotalCuantificado}}
              </div>
            </div>
          {{else}}
            <p class="sin-registros">Sin casos precedentes registrados.</p>
          {{/each}}
        </section>
      </aside>

      <article class="columna-derecha">
        <section class="cabecera-novedad">
          <div class="novedad-grid">
            <div class="campo">
              <div class="campo-valor">{{novedad.tipo}}</div>
              <div class="campo-etiqueta">Situación del bien</div>
            </div>
            <div class="campo">
              <div class="campo-valor">{{novedad.numero}}</div>
              <div class="campo-etiqueta">ID de registro de situación</div>
            </div>
            <div class="campo">
              <div class="campo-valor">{{novedad.fecha}}</div>
              <div class="campo-etiqueta">Fecha de resolución</div>
            </div>
          </div>

          <div class="afectacion">
            <div class="afectacion-valor">
              <strong>{{novedad.afectacionEstimadaNumero}}</strong>
              {{#if novedad.afectacionEstimadaLiteral}}
                ({{novedad.afectacionEstimadaLiteral}})
              {{/if}}
            </div>
            <div class="afectacion-etiqueta">Afectación estimada del bien</div>
          </div>
        </section>

        <section class="seccion">
          <h2 class="titulo-seccion">Detalle del bien: {{bien.tipoBien}}</h2>

          <div class="ultima-situacion">
            <strong>Última situación del bien:</strong>
            {{bien.ultimaSituacionBien}}
          </div>

          <div class="datos-bien-compactos">
            {{#each bien.datos}}
              <div class="dato-bien-compacto">
                <strong>{{etiqueta}}:</strong> {{valor}}
              </div>
            {{/each}}
            <div class="dato-bien-compacto">
              <strong>Costo aproximado:</strong> {{bien.valorAproximado}}
            </div>
            <div class="dato-bien-compacto">
              <strong>Costo cuantificado:</strong> {{bien.valorCuantificado}}
            </div>
          </div>

          <h2 class="titulo-seccion">Características del bien</h2>
          <p class="texto">
            {{#each bien.caracteristicas}}<strong>{{etiqueta}}:</strong> {{valor}}{{#unless @last}}; {{/unless}}{{else}}Sin características registradas.{{/each}}
          </p>

          <h2 class="titulo-seccion">
  Vinculo con personas afectadas
</h2>

<table class="tabla-detalle">
  <thead>
    <tr>
      <th style="width: 45%;">Persona</th>
      <th style="width: 25%;">Documento</th>
      <th style="width: 30%;">Tipo de vínculo</th>
    </tr>
  </thead>

  <tbody>
    {{#each bien.implicados}}
      <tr>
        <td>{{nombreCompleto}}</td>

        <td>
          {{#if numeroDocumento}}
            {{numeroDocumento}}
          {{else}}
            Sin documento registrado
          {{/if}}
        </td>

        <td>
          {{#if tipoVinculoDescripcion}}
            {{tipoVinculoDescripcion}}
          {{else}}
            Sin tipo de vínculo registrado
          {{/if}}
        </td>
      </tr>
    {{else}}
      <tr>
        <td colspan="3">
          Sin implicados vinculados al bien.
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

          <h2 class="titulo-seccion">
            Historial de situación del bien
          </h2>

          <table class="tabla-detalle">
            <thead>
              <tr>
                <th>Medida cautelar</th>
                <th>Fecha de resolución</th>
                <th>Fiscalía y autoridad</th>
              </tr>
            </thead>
            <tbody>
              {{#each bien.historialSituacionBien}}
                <tr class="{{#if esUltima}}fila-ultima{{/if}}">
                  <td>
                    {{medidaCautelar}}
                    {{#if esUltima}}<div><strong>(Última)</strong></div>{{/if}}
                  </td>
                  <td>{{fecha}}</td>
                  <td>
                    <div><strong>Fiscalía:</strong> {{fiscalia}}</div>
                    <div><strong>Autoridad:</strong> {{autoridad}}</div>
                  </td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="3">
                    Sin situaciones de pérdida de dominio registradas.
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section class="muestrario">
          <h2 class="titulo-seccion">Muestrario fotográfico del bien</h2>
          <div class="fotografias">
            {{#each bien.fotografias}}
              <figure class="fotografia">
                <div class="fotografia-imagen">
                  <span class="numero-fotografia">{{numero}}</span>
                  {{#if imagen}}
                    <img src="{{imagen}}" alt="Fotografía {{numero}}" />
                  {{else}}
                    <div class="foto-vacia">Sin fotografía disponible</div>
                  {{/if}}
                </div>
                {{#if descripcion}}
                  <figcaption>{{descripcion}}</figcaption>
                {{/if}}
              </figure>
            {{else}}
              <div class="sin-registros">Sin fotografías registradas.</div>
            {{/each}}
          </div>
        </section>

        <section class="seccion">
          <h2 class="titulo-seccion">Ubicación del secuestro</h2>

          <div class="ubicacion-contenido">
            <div class="ubicacion-mapa">
              {{#if bien.mapaImagen}}
                {{#if bien.googleMapsUrl}}
                  <a href="{{bien.googleMapsUrl}}" target="_blank" rel="noopener">
                    <img src="{{bien.mapaImagen}}" alt="Mapa del secuestro" />
                  </a>
                {{else}}
                  <img src="{{bien.mapaImagen}}" alt="Mapa del secuestro" />
                {{/if}}
                <div class="mapa-atribucion">© OpenStreetMap contributors</div>
              {{else}}
                <div class="sin-registros">
                  {{#if bien.mapaError}}
                    {{bien.mapaError}}
                  {{else}}
                    Mapa no disponible.
                  {{/if}}
                </div>
              {{/if}}
            </div>

            <div class="ubicacion-detalle">
              <div class="dato">
                <strong>Lugar:</strong>
                {{#if bien.lugarSecuestro}}
                  {{bien.lugarSecuestro}}
                {{else}}
                  Sin lugar registrado.
                {{/if}}
              </div>

              <table class="tabla-detalle">
                <tbody>
                  <tr>
                    <th>Latitud</th>
                    <td>
                      {{#if bien.latitud includeZero=true}}
                        {{bien.latitud}}
                      {{else}}
                        Sin registro
                      {{/if}}
                    </td>
                  </tr>
                  <tr>
                    <th>Longitud</th>
                    <td>
                      {{#if bien.longitud includeZero=true}}
                        {{bien.longitud}}
                      {{else}}
                        Sin registro
                      {{/if}}
                    </td>
                  </tr>
                </tbody>
              </table>

              {{#if bien.googleMapsUrl}}
                <div class="enlace-ubicacion">
                  <a href="{{bien.googleMapsUrl}}" target="_blank" rel="noopener">
                    Ver ubicación en Google Maps
                  </a>
                </div>
              {{/if}}
            </div>
          </div>
        </section>

        <footer class="pie">
          <div class="pie-linea"></div>
          <span>Fin de la transmisión</span>
        </footer>
      </article>
    </section>
  </main>
</body>
</html>