<!DOCTYPE html>
<html lang='es'>
<head>
    <meta charset='UTF-8' />
    <title>Reporte integral del caso LGI</title>
    <style>
    :root {
      --ink: #20271e;
      --navy: #385231;
      --line: #c5d3be;
      --blue: #eef3e9;
      --muted: #6b7566
    }
    * {
      box-sizing: border-box
    }
    html {
      background: #fff
    }
    body {
      margin: 0;
      width: 100%;
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      line-height: 1.5;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact
    }
    .header {
      display: flex;
      align-items: center;
      gap: 14px;
      break-inside: avoid;
      background: #f7f9f2;
      border-radius: 8px;
      padding: 14px 16px;
      border-bottom: 3px solid #4f6b43;
      margin-bottom: 18px
    }
    .logos {
      display: flex;
      align-items: center;
      gap: 9px
    }
    .logos img {
      width: 43px;
      height: 48px;
      object-fit: contain
    }
    .org {
      font-size: 9px;
      font-weight: 700;
      color: var(--navy);
      letter-spacing: .3px
    }
    .title {
      font-size: 17px;
      line-height: 1.25;
      font-weight: 700;
      color: var(--navy);
      margin: 5px 0
    }
    .subtitle {
      font-size: 10px;
      color: var(--muted)
    }
    h2 {
      color: var(--navy);
      font-size: 14px;
      margin: 20px 0 10px;
      border-bottom: 1px solid var(--line);
      padding-bottom: 6px;
      break-after: avoid;
      page-break-after: avoid
    }
    h3 {
      background: var(--blue);
      color: var(--navy);
      font-size: 11px;
      margin: 15px 0 8px;
      padding: 7px 9px;
      break-after: avoid;
      page-break-after: avoid
    }
    p {
      margin: 7px 0
    }
    .muted {
      color: var(--muted)
    }
    .text {
      white-space: pre-line;
      overflow-wrap: anywhere
    }
    .empty {
      color: var(--muted);
      font-style: italic;
      padding: 8px 0
    }
    .summary {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin: 12px 0 17px;
      break-inside: avoid
    }
    .metric {
      flex: 1 1 30%;
      background: #f7f9f2;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 10px
    }
    .metric span {
      display: block;
      color: var(--muted);
      font-size: 9px
    }
    .metric strong {
      display: block;
      font-size: 17px;
      color: var(--navy);
      margin-top: 3px
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      table-layout: fixed
    }
    thead {
      display: table-header-group
    }
    tr {
      break-inside: avoid;
      page-break-inside: avoid
    }
    th {
      background: var(--blue);
      color: var(--navy);
      font-weight: 700;
      text-align: left
    }
    td,
    th {
      padding: 7px 8px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
      overflow-wrap: anywhere
    }
    tbody tr:nth-child(even) {
      background: #f8faf5
    }
    .kv th {
      width: 25%;
      background: #f7f9f2;
      color: var(--muted);
      font-size: 10px
    }
    .kv td {
      width: 25%
    }
    .small {
      font-size: 9.5px
    }
    .badge {
      display: inline-block;
      padding: 2px 7px;
      background: #eef3e9;
      color: var(--navy);
      border-radius: 9px;
      font-size: 9px
    }
    .case-title {
      padding: 9px 11px;
      border-left: 3px solid #4f6b43;
      background: #f7f9f2;
      font-weight: 700;
      color: var(--navy);
      margin: 12px 0 8px;
      break-after: avoid
    }
    .values {
      display: flex;
      gap: 12px;
      margin: 10px 0 14px;
      break-inside: avoid
    }
    .value {
      flex: 1;
      border: 1px solid var(--line);
      padding: 9px;
      border-radius: 5px
    }
    .value span {
      display: block;
      color: var(--muted);
      font-size: 9px
    }
    .value strong {
      font-size: 12px
    }
    .closing {
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 9px;
      margin-top: 20px;
      padding-top: 9px
    }
    .photo {
      break-inside: avoid;
      margin: 10px 0
    }
    .photo img {
      max-width: 240px;
      max-height: 180px;
      object-fit: contain;
      border: 1px solid var(--line);
      padding: 5px;
      border-radius: 5px
    }
    .latest td {
      background: #eef3e9
    }
    a {
      color: #4f6b43;
      text-decoration: none
    }
    .photos {
      display: flex;
      flex-wrap: wrap;
      gap: 12px
    }
    .photos .photo {
      width: calc(50% - 6px)
    }
    .photos img {
      width: 100%;
      max-height: 180px
    }
    .precedente-resumen {
      border-left: 3px solid #4f6b43;
      background: #f7f9f2;
      padding: 10px 12px;
      margin: 10px 0 15px
    }
    .precedente-resumen p {
      margin: 3px 0
    }
    .precedente-resumen b {
      color: var(--navy)
    }
@page { size: 216mm 330mm; margin: 18mm 16mm; }
header { display:flex; align-items:center; gap:14px; background:#f7f9f2; border-radius:8px; padding:14px 16px; border-bottom:3px solid #4f6b43; margin-bottom:18px; break-inside:avoid; }
header > img { width:43px; height:48px; object-fit:contain; }
header h1 { margin:0 0 5px; font-size:9px; color:var(--navy); letter-spacing:.3px; }
header strong { display:block; font-size:17px; line-height:1.25; color:var(--navy); }
header p { margin:5px 0 0; font-size:10px; color:var(--muted); }
.resumen-portada { display:flex; flex-wrap:wrap; gap:9px; margin:12px 0 17px; break-inside:avoid; }
.resumen-portada > div { flex:1 1 30%; background:#f7f9f2; border:1px solid var(--line); border-radius:6px; padding:10px; }
.resumen-portada span { display:block; color:var(--muted); font-size:9px; }
.resumen-portada strong { display:block; font-size:17px; color:var(--navy); margin-top:3px; }
.ficha-caso .valor { font-weight:600; }
.ficha-caso .etiqueta { font-size:9px; color:var(--muted); margin-top:3px; }
.dato { display:inline; margin-right:10px; overflow-wrap:anywhere; }
.datos-adicionales-caso,.datos-actuacion,.datos-precedente { margin:8px 0 12px; }
.texto { white-space:pre-line; overflow-wrap:anywhere; margin:7px 0; }
.sin { color:var(--muted); font-style:italic; }
.actuacion > h2,.bien > h3,.empresa > h3 { border-left:3px solid #4f6b43; background:#f7f9f2; padding:9px 11px; }
.bien,.empresa { margin:12px 0; }
.ultima,.ultima td { background:#eef3e9; }
.ultima { padding:8px; margin:8px 0; border-left:3px solid #4f6b43; }
.fotos { display:flex; flex-wrap:wrap; gap:12px; margin:10px 0; }
.fotos figure { width:calc(50% - 6px); margin:0; min-width:0; break-inside:avoid; }
.fotos img { width:100%; height:180px; object-fit:contain; border:1px solid var(--line); padding:5px; border-radius:5px; }
figcaption { font-size:9px; color:var(--muted); margin-top:4px; overflow-wrap:anywhere; }
.ubicacion { display:grid; grid-template-columns:43mm minmax(0,1fr); gap:12px; margin:12px 0; break-inside:avoid; }
.ubicacion img { width:43mm; height:43mm; object-fit:contain; }
.atribucion { font-size:7px; color:var(--muted); }
.pie { border-top:1px solid var(--line); color:var(--muted); font-size:9px; margin-top:20px; padding-top:9px; }
.col-numero { width:6%; } .col-nombre { width:27%; } .col-documento { width:20%; } .col-relacion { width:17%; }

.precedente-resumen { font-size:11px; line-height:1.5; }
.precedente-resumen p { margin:3px 0; }
.tabla-campos .campo-label { width:25%; }
.tabla-campos .campo-valor { width:25%; }
h4 { font-size:11px; color:var(--navy); background:var(--blue); padding:7px 9px; margin:15px 0 8px; break-after:avoid; }
</style>
</head>
<body>
    <header>
        <img src='{{institucional}}' alt='Logotipo institucional' />
        <img src='{{escudo}}' alt='Escudo institucional' />
        <div>
            <h1>Grupo de Investigación y Análisis Económico Financiero</h1><strong>REPORTE INTEGRAL · LGI</strong>
            <p>{{caso.nombreCaso}}</p>
        </div>
    </header>
    <section class='portada'>
        <div class='resumen-portada'>
            <div><span>Actuaciones</span><strong>{{cantidadActuaciones}}</strong></div>
            <div><span>Cantidad de bienes</span><strong>{{cantidadBienes}}</strong></div>
            <div><span>Valor aproximado registrado</span><strong>{{totalBienes}}</strong></div>
        </div>
        <h2>Datos generales del caso</h2>
        <table class='kv ficha-caso'>
            <tbody>
                <tr>
                    <th>Nombre del caso</th><td>{{caso.nombreCaso}}</td>
                    <th>Fecha de inicio</th><td>{{caso.fechaInicio}}</td>
                </tr>
                <tr>
                    <th>N.º caso Fiscalía</th><td>{{caso.numeroCasoFiscalia}}</td>
                    <th>N.º caso GIAEF</th><td>{{caso.numeroCasoGiaef}}</td>
                </tr>
                <tr>
                    <th>Etapa procesal</th><td>{{caso.etapa}}</td>
                    <th>Investigación financiera paralela</th><td>{{caso.cudIfp}}</td>
                </tr>
                <tr>
                    <th>Forma de inicio del caso</th><td colspan="3">{{caso.formaInicio}}</td>
                </tr>
                <tr>
                    <th>Lugar donde se investiga el caso</th><td colspan="3">{{caso.lugarInvestigacion}}</td>
                </tr>
                <tr>
                    <th>Investigadores asignados</th><td colspan="3">{{#each caso.investigadores}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</td>
                </tr>
                <tr>
                    <th>Fiscal asignado</th><td>{{caso.fiscalAsignado}}</td>
                    <th>Control jurisdiccional</th><td>{{caso.controlJurisdiccional}}</td>
                </tr>
            </tbody>
        </table>
        <table class='tabla tabla-campos'>
            <colgroup>
                <col class='campo-label' />
                <col class='campo-valor' />
                <col class='campo-label' />
                <col class='campo-valor' />
            </colgroup>
            <tbody>{{#each caso.filasDatos}}<tr>
                    <th>{{izquierda.etiqueta}}</th>
                    <td>{{izquierda.valor}}</td>
                    <th>{{#if derecha}}{{derecha.etiqueta}}{{/if}}</th>
                    <td>{{#if derecha}}{{derecha.valor}}{{/if}}</td>
                </tr>{{/each}}</tbody>
        </table>
        <h2>Personas investigadas del caso</h2>
        <table class='tabla tabla-personas'>
            <thead>
                <tr>
                    <th style='width:5%'>N.º</th>
                    <th style='width:35%'>Nombre completo</th>
                    <th style='width:18%'>Documento</th>
                    <th style='width:24%'>Relación</th>
                    <th style='width:8%'>Sexo</th>
                    <th style='width:10%'>Estado</th>
                </tr>
            </thead>
            <tbody>{{#each personas}}<tr>
                    <td>{{numero}}</td>
                    <td><strong>{{nombre}}</strong></td>
                    <td>{{documento}}</td>
                    <td>{{relacion}}</td>
                    <td>{{sexo}}</td>
                    <td>{{estadoPersona}}</td>
                </tr>
                {{#if filasDatos}}<tr>
                    <td colspan='6'>
                        <table class='tabla tabla-campos'>
                            <colgroup>
                                <col class='campo-label' />
                                <col class='campo-valor' />
                                <col class='campo-label' />
                                <col class='campo-valor' />
                            </colgroup>
                            <tbody>{{#each filasDatos}}<tr>
                                    <th>{{izquierda.etiqueta}}</th>
                                    <td>{{izquierda.valor}}</td>
                                    <th>{{#if derecha}}{{derecha.etiqueta}}{{/if}}</th>
                                    <td>{{#if derecha}}{{derecha.valor}}{{/if}}</td>
                                </tr>{{/each}}</tbody>
                        </table>
                    </td>
                </tr>{{/if}}
                {{else}}<tr>
                    <td colspan='6'>Sin personas registradas.</td>
                </tr>{{/each}}</tbody>
        </table>
        <h2>Casos precedentes</h2>
{{#each precedentes}}
  <div class="precedente-resumen">
    {{#each datos}}
      <p class="text"><b>{{etiqueta}}:</b> {{valor}}</p>
    {{else}}
      <p class="empty">Sin información del precedente.</p>
    {{/each}}
  </div>
{{else}}
  <p class="empty">No hay casos precedentes registrados.</p>
{{/each}}
</section>
    {{#each actuaciones}}
    <section class='actuacion'>
        <h2>Actuación {{numeroSeccion}} — {{novedad.numero}}</h2>
        <table class='tabla'>
            <thead>
                <tr>
                    <th>Tipo de informe</th>
                    <th>N.º novedad</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{novedad.tipo}}</td>
                    <td>{{novedad.numero}}</td>
                    <td>{{novedad.fecha}}</td>
                </tr>
            </tbody>
        </table>
        <h3>Datos de la actuación</h3>
        <div class='datos-actuacion'>
            <table class='tabla tabla-campos'>
                <colgroup>
                    <col class='campo-label' />
                    <col class='campo-valor' />
                    <col class='campo-label' />
                    <col class='campo-valor' />
                </colgroup>
                <tbody>{{#each filasActuacion}}<tr>
                        <th>{{izquierda.etiqueta}}</th>
                        <td>{{izquierda.valor}}</td>
                        <th>{{#if derecha}}{{derecha.etiqueta}}{{/if}}</th>
                        <td>{{#if derecha}}{{derecha.valor}}{{/if}}</td>
                    </tr>{{/each}}</tbody>
            </table>
        </div>
        <h3>Síntesis del caso / actuación</h3>
        <p class='texto'>{{novedad.sintesis}}</p>
        <h3>Responsables</h3>
        <table class='tabla tabla-campos'>
            <colgroup>
                <col class='campo-label' />
                <col class='campo-valor' />
                <col class='campo-label' />
                <col class='campo-valor' />
            </colgroup>
            <tbody>{{#each filasResponsables}}<tr>
                    <th>{{izquierda.etiqueta}}</th>
                    <td>{{izquierda.valor}}</td>
                    <th>{{#if derecha}}{{derecha.etiqueta}}{{/if}}</th>
                    <td>{{#if derecha}}{{derecha.valor}}{{/if}}</td>
                </tr>{{/each}}</tbody>
        </table>
        <h3>Bienes de la actuación</h3>
        {{#each bienes}}
        <section class='bien'>
            <h3>Bien {{numeroBien}} — {{tipoBien}}</h3>
            <div class='ultima'><strong>Última situación jurídica:</strong> {{ultimaSituacionJuridica}}</div>
            <table class='tabla tabla-campos'>
                <colgroup>
                    <col class='campo-label' />
                    <col class='campo-valor' />
                    <col class='campo-label' />
                    <col class='campo-valor' />
                </colgroup>
                <tbody>{{#each filasDatos}}<tr>
                        <th>{{izquierda.etiqueta}}</th>
                        <td>{{izquierda.valor}}</td>
                        <th>{{#if derecha}}{{derecha.etiqueta}}{{/if}}</th>
                        <td>{{#if derecha}}{{derecha.valor}}{{/if}}</td>
                    </tr>{{/each}}</tbody>
            </table>
            <table class='tabla'>
                <thead>
                    <tr>
                        <th>Valor aproximado</th>
                        <th>Valor cuantificado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{valorAproximado}}</td>
                        <td>{{valorCuantificado}}</td>
                    </tr>
                </tbody>
            </table>
            <h3>Características</h3>
<p class="text">{{#each caracteristicas}}<b>{{etiqueta}}:</b> {{valor}}{{#unless @last}}; {{/unless}}{{else}}No registradas{{/each}}</p>
<h4>Historial de situación jurídica</h4>
            <table class='tabla'>
                <thead>
                    <tr>
                        <th>Situación</th>
                        <th>Fecha</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>{{#each historialJuridico}}<tr class='{{#if esUltima}}ultima{{/if}}'>
                        <td>{{situacion}}{{#if esUltima}} (Última){{/if}}</td>
                        <td>{{fecha}}</td>
                        <td>{{#each detalles}}<div><strong>{{etiqueta}}:</strong> {{valor}}</div>{{/each}}</td>
                    </tr>{{else}}<tr>
                        <td colspan='3'>Sin historial jurídico.</td>
                    </tr>{{/each}}</tbody>
            </table>
            {{#if anotacionesJuridicas}}<h4>Anotaciones jurídicas</h4>
            <table class='tabla'>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>{{#each anotacionesJuridicas}}<tr>
                        <td>{{fecha}}</td>
                        <td>{{descripcion}}</td>
                    </tr>{{/each}}</tbody>
            </table>{{/if}}
            <h4>Historial de situación del bien</h4>
            <table class='tabla'>
                <thead>
                    <tr>
                        <th>Calidad y fecha</th>
                        <th>Documento y fiscal</th>
                        <th>Recepción y ubicación</th>
                    </tr>
                </thead>
                <tbody>{{#each historialSituacionBien}}<tr>
                        <td>{{calidad}}<div>{{fecha}}</div>
                        </td>
                        <td>
                            <div>{{tipoDocumento}}: {{numeroDocumento}}</div>
                            <div>Fiscal: {{fiscalRequirente}}</div>
                        </td>
                        <td>
                            <div>{{responsableRecepcion}}</div>
                            <div>{{institucion}}</div>
                            <div>{{ubicacion}}</div>
                        </td>
                    </tr>{{else}}<tr>
                        <td colspan='3'>Sin historial de situación del bien.</td>
                    </tr>{{/each}}</tbody>
            </table>
            <h4>Muestrario fotográfico</h4>
            <div class='fotos'>{{#each fotografias}}<figure>{{#if imagen}}<img src='{{imagen}}'
                        alt='Fotografía del bien' />{{/if}}<figcaption>{{numero}}. {{descripcion}}</figcaption>
                </figure>{{else}}<p class='sin'>Sin fotografías registradas.</p>{{/each}}</div>
            <div class='ubicacion'>
                <div>{{#if mapaImagen}}<a href='{{googleMapsUrl}}'><img src='{{mapaImagen}}'
                            alt='Ubicación del bien' /></a>
                    <div class='atribucion'>© OpenStreetMap contributors</div>{{else}}<p class='sin'>{{mapaError}}</p>
                    {{/if}}
                </div>
                <div>
                    <p><strong>Lugar:</strong> {{lugarSecuestro}}</p>
                    <table class='tabla'>
                        <tbody>
                            <tr>
                                <th>Latitud</th>
                                <td>{{latitud}}</td>
                            </tr>
                            <tr>
                                <th>Longitud</th>
                                <td>{{longitud}}</td>
                            </tr>
                        </tbody>
                    </table>{{#if googleMapsUrl}}<a href='{{googleMapsUrl}}'>Ver ubicación en Google Maps</a>{{/if}}
                </div>
            </div>
        </section>
        {{else}}<p class='sin'>Sin bienes activos registrados.</p>{{/each}}
        <h3>Personas jurídicas de la actuación</h3>
        {{#each empresas}}
        <section class='empresa'>
            <h3>{{nombre}}</h3>
            <div class='dato'><strong>Vínculo:</strong> {{vinculo}}</div>
            <div class='ultima'>Última situación jurídica: {{ultimaSituacionJuridica}}</div>
            <table class='tabla tabla-campos'>
                <colgroup>
                    <col class='campo-label' />
                    <col class='campo-valor' />
                    <col class='campo-label' />
                    <col class='campo-valor' />
                </colgroup>
                <tbody>{{#each filasDatos}}<tr>
                        <th>{{izquierda.etiqueta}}</th>
                        <td>{{izquierda.valor}}</td>
                        <th>{{#if derecha}}{{derecha.etiqueta}}{{/if}}</th>
                        <td>{{#if derecha}}{{derecha.valor}}{{/if}}</td>
                    </tr>{{/each}}</tbody>
            </table>
            <div class='dato'><strong>Fecha de registro:</strong> {{fechaRegistro}}</div>
            <div class='dato'><strong>Documento adjunto:</strong> {{#if tieneDocumento}}Registrado{{else}}Sin
                registro{{/if}}</div>
            <h4>Implicados</h4>
            <table class='tabla'>
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo de implicado</th>
                        <th>Documento</th>
                    </tr>
                </thead>
                <tbody>{{#each implicados}}<tr>
                        <td>{{nombre}}</td>
                        <td>{{tipoImplicado}}</td>
                        <td>{{tipoDocumento}}: {{numeroDocumento}}</td>
                    </tr>{{else}}<tr>
                        <td colspan='3'>Sin implicados activos.</td>
                    </tr>{{/each}}</tbody>
            </table>
            <h4>Historial jurídico</h4>
            <table class='tabla'>
                <thead>
                    <tr>
                        <th>Situación</th>
                        <th>Fecha</th>
                        <th>Registro</th>
                    </tr>
                </thead>
                <tbody>{{#each historialJuridico}}<tr class='{{#if esUltima}}ultima{{/if}}'>
                        <td>{{situacion}}{{#if esUltima}} (Última){{/if}}</td>
                        <td>{{fecha}}</td>
                        <td>{{fechaRegistro}}</td>
                    </tr>{{else}}<tr>
                        <td colspan='3'>Sin historial jurídico.</td>
                    </tr>{{/each}}</tbody>
            </table>
            {{#if imagen}}<div class='fotos'>
                <figure><img src='{{imagen}}' alt='Imagen de la empresa' />
                    <figcaption>{{nombre}}</figcaption>
                </figure>
            </div>{{else}}<p class='sin'>Sin imagen registrada.</p>{{/if}}
            <div class='ubicacion'>
                <div>{{#if mapaImagen}}<a href='{{googleMapsUrl}}'><img src='{{mapaImagen}}'
                            alt='Ubicación de la empresa' /></a>
                    <div class='atribucion'>© OpenStreetMap contributors</div>{{else}}<p class='sin'>{{mapaError}}</p>
                    {{/if}}
                </div>
                <div>
                    <p>{{direccion}}</p>
                    <table class='tabla'>
                        <tbody>
                            <tr>
                                <th>Latitud</th>
                                <td>{{latitud}}</td>
                            </tr>
                            <tr>
                                <th>Longitud</th>
                                <td>{{longitud}}</td>
                            </tr>
                        </tbody>
                    </table>{{#if googleMapsUrl}}<a href='{{googleMapsUrl}}'>Ver ubicación en Google Maps</a>{{/if}}
                </div>
            </div>
        </section>{{else}}<p class='sin'>Sin empresas registradas.</p>{{/each}}
    </section>{{/each}}
    <section class='actuacion'>
        <h2>Resumen de bienes del caso</h2>
        <table class='tabla'>
            <thead>
                <tr>
                    <th>Categoría</th>
                    <th>Cantidad</th>
                    <th>Valor aproximado total</th>
                </tr>
            </thead>
            <tbody>{{#each resumen}}<tr>
                    <td>{{categoria}}{{#if faltantes}}<div class='sin'>{{faltantes}} registro(s) sin valoración.</div>
                        {{/if}}</td>
                    <td>{{cantidad}}</td>
                    <td>{{total}}</td>
                </tr>{{/each}}</tbody>
            <tfoot>
                <tr>
                    <th>Total</th>
                    <th>{{cantidadBienes}}</th>
                    <th>{{totalBienes}}</th>
                </tr>
            </tfoot>
        </table>
        {{#if faltantes}}<p class='sin'>El total incluye únicamente los importes registrados; {{faltantes}} registro(s)
            carecen de valoración.</p>{{/if}}
        <h2>Conclusión del caso</h2>
        <table class='tabla'>
            <thead>
                <tr>
                    <th>Grupo</th>
                    <th>Selecciones activas</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th>Ciclos LGI</th>
                    <td>{{#each conclusion.ciclos}}<div>{{descripcion}}</div>{{else}}Sin selecciones activas.{{/each}}
                    </td>
                </tr>
                <tr>
                    <th>Verbos rectores</th>
                    <td>{{#each conclusion.verbosRectores}}<div>{{descripcion}}</div>{{else}}Sin selecciones
                        activas.{{/each}}</td>
                </tr>
                <tr>
                    <th>Tipologías</th>
                    <td>{{#each conclusion.tipologias}}<div>{{descripcion}}</div>{{else}}Sin selecciones
                        activas.{{/each}}</td>
                </tr>
            </tbody>
        </table>
    </section>
    <footer class='pie'>Fin del reporte integral del caso</footer>
</body>
</html>