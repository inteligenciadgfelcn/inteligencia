<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Helvetica', sans-serif; margin: 20px; color: #333; }
        .header { display: flex; align-items: center; border-bottom: 2px solid #004a2f; padding-bottom: 10px; }
        .logo { width: 80px; height: auto; }
        .title-container { flex-grow: 1; text-align: center; }
        h1 { margin: 0; font-size: 18px; color: #004a2f; }
        h2 { margin: 5px 0; font-size: 14px; text-transform: uppercase; }
        
        .sujeto-box { background: #f9f9f9; padding: 15px; border-radius: 5px; margin: 20px 0; border: 1px solid #ddd; }
        .sujeto-title { font-weight: bold; color: #004a2f; margin-bottom: 10px; }
        .sujeto-info { font-size: 14px; line-height: 1.6; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: center; font-size: 11px; }
        th { background-color: #f2f2f2; font-weight: bold; }
        
        .total { font-weight: bold; background: #fafafa; }
        
        .footer { position: fixed; bottom: 0; width: 100%; font-size: 10px; text-align: right; border-top: 1px solid #eee; padding-top: 5px; }
    </style>
</head>
<body>
    <div class="header">
        <img src="{{institucional}}" class="logo" alt="Logo FELCN">
        <div class="title-container">
            <h1>FUERZA ESPECIAL DE LUCHA CONTRA EL NARCOTRÁFICO</h1>
            <h2>Reporte de Inteligencia - Antecedentes</h2>
        </div>
    </div>

    <div class="sujeto-box">
        <div class="sujeto-title">DATOS DEL SUJETO</div>
        <div class="sujeto-info">
            <strong>Nombre:</strong> {{sujeto.nombre}}<br>
            <strong>C.I.:</strong> {{sujeto.ci}}<br>
            <strong>Nacionalidad:</strong> {{sujeto.nacionalidad}}
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Fecha</th>
                <th>Delito</th>
                <th>Estado</th>
                <th>Caso</th>
            </tr>
        </thead>
        <tbody>
            {{#each antecedentes}}
            <tr>
                <td>{{@index}}</td>
                <td>{{this.fecha}}</td>
                <td>{{this.delito}}</td>
                <td>{{this.estado}}</td>
                <td>{{this.caso}}</td>
            </tr>
            {{/each}}
            <tr class="total">
                <td colspan="4">Total de Registros</td>
                <td>{{totalRegistros}}</td>
            </tr>
        </tbody>
    </table>

    <div class="footer">
        Generado el: {{fecha}} | Sistema de Inteligencia FELCN
    </div>
</body>
</html>
