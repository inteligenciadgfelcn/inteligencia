<html lang='es'>
  <head>
    <meta charset='UTF-8' />

    <title>
      Reporte GIAEF
    </title>

    <style>
      :root {
        --verde: #4f6b43;
        --verde-oscuro: #3d5633;
        --verde-claro: #eef3ea;
        --verde-fondo: #fafbf6;
        --naranja: #d58d55;
        --amarillo: #e2c317;
        --texto: #181818;
        --gris: #777777;
        --blanco: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      @page {
        size: 216mm 330mm;
        margin: 0;
      }

      html,
      body {
        width: 216mm;
        min-height: 330mm;
        margin: 0;
        padding: 0;
      }

      body {
        color: var(--texto);
        background: var(--blanco);
        font-family: Arial, Helvetica, sans-serif;
        font-size: 9px;
      }

      .pagina {
        position: relative;
        width: 216mm;
        min-height: 330mm;
        padding: 9mm 10mm 8mm;
        overflow: hidden;
        background: var(--blanco);
      }

      /* ENCABEZADO */

      .encabezado {
        display: grid;
        grid-template-columns: 41mm 1fr;
        align-items: center;
        min-height: 24mm;
        padding: 2mm;
        background: var(--verde-fondo);
      }

      .logos {
        display: flex;
        align-items: center;
        gap: 2mm;
      }

      .logo {
        width: 18mm;
        height: 18mm;
        object-fit: contain;
      }

      .separador-logo {
        width: 1px;
        height: 18mm;
        background: var(--verde);
      }

      .encabezado-texto {
        padding: 0 3mm;
        text-align: center;
      }

      .titulo-institucion {
        margin: 0;
        color: var(--verde);
        font-size: 16px;
        font-weight: 500;
        line-height: 1.15;
      }

      .titulo-reporte {
        margin: 2mm 0 0;
        font-size: 10px;
        font-weight: 500;
      }

      .titulo-reporte strong {
        font-weight: 700;
      }

      /* TIPO DE ACCIÓN */

      .titulo-accion {
        width: 38%;
        min-height: 9mm;
        margin: 0;
        padding: 2mm 3mm;
        color: var(--verde);
        background: var(--verde-fondo);
        font-size: 13px;
        font-weight: 700;
      }

      /* CUERPO */

      .cuerpo {
        display: grid;
        grid-template-columns: 38% 62%;
        align-items: stretch;
        min-height: 280mm;
      }

      .columna-izquierda {
        min-height: 280mm;
        margin: 0;
        padding: 1mm 2mm 4mm;
        background: var(--verde-fondo);
        border-right: 2px solid var(--verde);
      }

      .columna-derecha {
        position: relative;
        padding: 1mm 0 10mm 3mm;
      }

      /* CAMPOS */

      .fila-doble {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5mm;
        margin-bottom: 2.5mm;
      }

      .campo {
        min-width: 0;
        text-align: center;
      }

      .campo-completo {
        margin-bottom: 2.5mm;
        text-align: center;
      }

      .campo-valor {
        min-height: 5mm;
        padding: 0 1mm 0.7mm;
        border-bottom: 1px solid var(--naranja);
        font-size: 10px;
        font-weight: 500;
        line-height: 1.15;
        overflow-wrap: anywhere;
      }

      .campo-etiqueta {
        padding-top: 0.5mm;
        color: var(--verde);
        font-size: 6.4px;
        font-weight: 500;
        line-height: 1;
        text-transform: uppercase;
      }

      .investigadores {
        font-size: 9.3px;
        line-height: 1.2;
      }

      .investigadores div {
        margin-bottom: 0.5mm;
      }

      /* SECCIONES */

      .seccion {
        margin-bottom: 3mm;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .titulo-seccion {
        margin: 0 0 1mm;
        color: var(--verde);
        font-size: 8.6px;
        font-weight: 700;
        line-height: 1.15;
        text-transform: uppercase;
      }

      .texto {
        margin: 0;
        font-size: 8.7px;
        line-height: 1;
        text-align: justify;
        white-space: pre-line;
      }

      .dato {
        margin-bottom: 0.7mm;
        font-size: 8.7px;
        line-height: 1.2;
      }

      .dato strong {
        font-weight: 700;
      }

      .lista {
        margin: 0;
        padding-left: 5mm;
      }

      .lista li {
        margin-bottom: 0.7mm;
        padding-left: 0.5mm;
        font-size: 8.7px;
        line-height: 1.2;
      }

      .sin-registros {
        color: var(--gris);
        font-style: italic;
      }

      /* PERSONAS INVESTIGADAS */

      .personas {
        margin: 0 -2mm 4mm;
        padding: 2mm;
        border-top: 1.5px solid var(--verde);
      }

      .persona {
        display: grid;
        grid-template-columns: 5mm 1fr;
        gap: 1mm;
        margin-bottom: 1.2mm;
        font-size: 8.7px;
        line-height: 1.22;
      }

      .persona-numero {
        font-weight: 700;
      }

      .persona-documento {
        display: block;
      }

      /* CABECERA DE NOVEDAD */

      .cabecera-novedad {
        padding: 0 2mm 3mm;
        border-bottom: 2px solid var(--verde);
      }

      .novedad-grid {
        display: grid;
        grid-template-columns: 1.6fr 0.8fr 0.9fr;
        gap: 4mm;
        align-items: end;
      }

      .novedad-grid .campo-valor {
        font-size: 10px;
      }

      .afectacion {
        margin-top: 2mm;
        text-align: center;
      }

      .afectacion-valor {
        padding: 0 2mm 0.8mm;
        border-bottom: 1px solid var(--naranja);
        font-size: 10px;
        line-height: 1.2;
      }

      .afectacion-valor strong {
        font-weight: 700;
      }

      .afectacion-etiqueta {
        margin-top: 0.5mm;
        color: var(--verde);
        font-size: 6.4px;
        text-transform: uppercase;
      }

      /* SÍNTESIS DE LA NOVEDAD */

      .sintesis-novedad {
        min-height: 105mm;
        padding: 3mm 2mm 2mm;
      }

      .sintesis-novedad .titulo-seccion {
        font-size: 9px;
      }

      .sintesis-novedad .texto {
        font-size: 9.1px;
        line-height: 1.3;
      }

      /* BIENES */

      .bienes {
        min-height: 43mm;
        padding: 0 2mm;
      }

      .lista-bienes {
        margin: 0;
        padding-left: 6mm;
      }

      .lista-bienes li {
        margin-bottom: 0.8mm;
        padding-left: 0.5mm;
        font-size: 9px;
        line-height: 1.2;
      }

      .bien-fila {
        display: flex;
        justify-content: space-between;
        gap: 3mm;
      }

      .bien-descripcion {
        flex: 1;
      }

      .bien-valor {
        flex-shrink: 0;
        font-weight: 600;
        white-space: nowrap;
      }

      /* FOTOGRAFÍAS */

      .muestrario {
        padding: 2mm;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .fotografias {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2mm;
        margin-top: 2mm;
      }

      .fotografia {
        position: relative;
        height: 38mm;
        overflow: hidden;
        background: var(--verde-claro);
        border: 1px solid var(--verde);
      }

      .fotografia img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .numero-fotografia {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 2;
        min-width: 8mm;
        padding: 2mm;
        color: var(--texto);
        background: var(--amarillo);
        font-size: 9px;
        font-weight: 700;
        text-align: center;
      }

      .foto-vacia {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        color: var(--gris);
        font-size: 7px;
        font-weight: 600;
        text-transform: uppercase;
      }

      /* PIE */

      .pie {
        position: absolute;
        right: 5mm;
        bottom: 3mm;
        left: 12mm;
        display: flex;
        align-items: center;
        gap: 2mm;
        font-size: 8.5px;
      }

      .pie-linea {
        flex: 1;
        border-top: 1px dashed var(--naranja);
      }

      .pie-texto {
        white-space: nowrap;
      }
    </style>
  </head>

  <body>
    <main class='pagina'>
      <!-- ENCABEZADO -->

      <header class='encabezado'>
        <div class='logos'>
          <img
            class='logo'
            src='{{institucional}}'
            alt='Logotipo institucional'
          />

          <span class='separador-logo'></span>

          <img class='logo' src='{{escudo}}' alt='Escudo institucional' />
        </div>

        <div class='encabezado-texto'>
          <h1 class='titulo-institucion'>
            Grupo de Investigación y Análisis Económico Financiero
          </h1>

          <p class='titulo-reporte'>
            Reporte N.º
            <strong>
              {{reporte.numero}}/{{reporte.gestion}}
            </strong>

            - División Regional del
            {{reporte.divisionRegional}}
          </p>
        </div>
      </header>

      <div class='titulo-accion'>
        {{accion.tipo}}
      </div>

      <section class='cuerpo'>
        <!-- COLUMNA IZQUIERDA -->

        <aside class='columna-izquierda'>
          <div class='fila-doble'>
            <div class='campo'>
              <div class='campo-valor'>
                {{accion.nombreCaso}}
              </div>

              <div class='campo-etiqueta'>
                Nombre del caso
              </div>
            </div>

            <div class='campo'>
              <div class='campo-valor'>
                {{accion.fechaInicio}}
              </div>

              <div class='campo-etiqueta'>
                Fecha inicio
              </div>
            </div>
          </div>

          <div class='fila-doble'>
            <div class='campo'>
              <div class='campo-valor'>
                {{accion.numeroCasoFiscalia}}
              </div>

              <div class='campo-etiqueta'>
                N.º caso Fiscalía
              </div>
            </div>

            <div class='campo'>
              <div class='campo-valor'>
                {{accion.numeroCasoGiaef}}
              </div>

              <div class='campo-etiqueta'>
                N.º caso GIAEF
              </div>
            </div>
          </div>

          <div class='fila-doble'>
            <div class='campo'>
              <div class='campo-valor'>
                {{accion.etapa}}
              </div>

              <div class='campo-etiqueta'>
                Etapa
              </div>
            </div>

            <div class='campo'>
              <div class='campo-valor'>
                {{accion.investigacionFinancieraParalela}}
              </div>

              <div class='campo-etiqueta'>
                Inv. fin. paralela
              </div>
            </div>
          </div>

          <div class='campo-completo'>
            <div class='campo-valor'>
              {{accion.formaInicio}}
            </div>

            <div class='campo-etiqueta'>
              Forma de inicio del caso
            </div>
          </div>

          <div class='campo-completo'>
            <div class='campo-valor'>
              {{accion.lugarInvestigacion}}
            </div>

            <div class='campo-etiqueta'>
              Lugar donde se investiga el caso
            </div>
          </div>

          <div class='campo-completo'>
            <div class='campo-valor investigadores'>
              {{#each accion.investigadores}}
                <div>
                  {{this}}
                </div>
              {{else}}
                <div class='sin-registros'>
                  Sin investigadores asignados
                </div>
              {{/each}}
            </div>

            <div class='campo-etiqueta'>
              Investigadores asignados al caso
            </div>
          </div>

          <div class='campo-completo'>
            <div class='campo-valor'>
              {{accion.fiscalAsignado}}
            </div>

            <div class='campo-etiqueta'>
              Fiscal asignado al caso
            </div>
          </div>

          <div class='campo-completo'>
            <div class='campo-valor'>
              {{accion.controlJurisdiccional}}
            </div>

            <div class='campo-etiqueta'>
              Control jurisdiccional
            </div>
          </div>

          <!-- PERSONAS INVESTIGADAS -->

          <section class='personas'>
            <h2 class='titulo-seccion'>
              Personas investigadas:
            </h2>

            {{#each personasInvestigadas}}
              <div class='persona'>
                <div class='persona-numero'>
                  {{numero}}.
                </div>

                <div>
                  {{nombre}}

                  {{#if documento}}
                    <span class='persona-documento'>
                      {{documento}}
                    </span>
                  {{/if}}
                </div>
              </div>
            {{else}}
              <div class='sin-registros'>
                Sin personas investigadas registradas.
              </div>
            {{/each}}
          </section>

          <!-- DELITO PRECEDENTE -->

          <section class='seccion'>
            <h2 class='titulo-seccion'>
              Síntesis del caso delito precedente:
            </h2>

            <div class='dato'>
              <strong>Caso:</strong>
              {{delitoPrecedente.numeroCaso}}
            </div>

            <div class='dato'>
              <strong>Fecha:</strong>
              {{delitoPrecedente.fecha}}
            </div>

            <div class='dato'>
              <strong>Unidad:</strong>
              {{delitoPrecedente.unidad}}
            </div>

            <div class='dato'>
              <strong>Lugar:</strong>
              {{delitoPrecedente.lugar}}
            </div>

            <div class='dato'>
              <strong>Aprehendidos:</strong>
              {{delitoPrecedente.aprehendidos}}
            </div>

            {{#if delitoPrecedente.ampliados}}
              <div class='dato'>
                <strong>Ampliados:</strong>
              </div>

              <ul class='lista'>
                {{#each delitoPrecedente.ampliados}}
                  <li>
                    {{this}}
                  </li>
                {{/each}}
              </ul>
            {{/if}}

            {{#if delitoPrecedente.secuestros}}
              <div class='dato'>
                <strong>Secuestros:</strong>
                {{delitoPrecedente.secuestros}}
              </div>
            {{/if}}
          </section>

          {{#if delitoPrecedente.inmuebleSecuestrado}}
            <section class='seccion'>
              <h2 class='titulo-seccion'>
                Inmueble secuestrado:
              </h2>

              <p class='texto'>
                {{delitoPrecedente.inmuebleSecuestrado}}
              </p>
            </section>
          {{/if}}

          {{#if delitoPrecedente.dineroSecuestrado}}
            <section class='seccion'>
              <h2 class='titulo-seccion'>
                Secuestro de dinero:
              </h2>

              <ul class='lista'>
                {{#each delitoPrecedente.dineroSecuestrado}}
                  <li>
                    {{this}}
                  </li>
                {{/each}}
              </ul>
            </section>
          {{/if}}

          {{#if delitoPrecedente.vehiculosSecuestrados}}
            <section class='seccion'>
              <h2 class='titulo-seccion'>
                Vehículos secuestrados:
              </h2>

              <ul class='lista'>
                {{#each delitoPrecedente.vehiculosSecuestrados}}
                  <li>
                    {{this}}
                  </li>
                {{/each}}
              </ul>
            </section>
          {{/if}}

          {{#if delitoPrecedente.mediosComunicacion}}
            <section class='seccion'>
              <h2 class='titulo-seccion'>
                Medios de comunicación:
              </h2>

              <ul class='lista'>
                {{#each delitoPrecedente.mediosComunicacion}}
                  <li>
                    {{this}}
                  </li>
                {{/each}}
              </ul>
            </section>
          {{/if}}

          {{#if delitoPrecedente.armamentoSecuestrado}}
            <section class='seccion'>
              <h2 class='titulo-seccion'>
                Armamento secuestrado:
              </h2>

              <p class='texto'>
                {{delitoPrecedente.armamentoSecuestrado}}
              </p>
            </section>
          {{/if}}

          {{#if delitoPrecedente.sustanciasSecuestradas}}
            <section class='seccion'>
              <h2 class='titulo-seccion'>
                Sustancias secuestradas:
              </h2>

              <p class='texto'>
                {{delitoPrecedente.sustanciasSecuestradas}}
              </p>
            </section>
          {{/if}}
        </aside>

        <!-- COLUMNA DERECHA -->

        <article class='columna-derecha'>
          <section class='cabecera-novedad'>
            <div class='novedad-grid'>
              <div class='campo'>
                <div class='campo-valor'>
                  {{novedad.tipo}}
                </div>

                <div class='campo-etiqueta'>
                  Novedad
                </div>
              </div>

              <div class='campo'>
                <div class='campo-valor'>
                  {{novedad.numero}}
                </div>

                <div class='campo-etiqueta'>
                  N.º novedad
                </div>
              </div>

              <div class='campo'>
                <div class='campo-valor'>
                  {{novedad.fecha}}
                </div>

                <div class='campo-etiqueta'>
                  Fecha
                </div>
              </div>
            </div>

            <div class='afectacion'>
              <div class='afectacion-valor'>
                <strong>
                  {{novedad.afectacionEstimadaNumero}}
                </strong>

                {{#if novedad.afectacionEstimadaLiteral}}
                  ({{novedad.afectacionEstimadaLiteral}})
                {{/if}}
              </div>

              <div class='afectacion-etiqueta'>
                Afectación estimada
              </div>
            </div>
          </section>

          <!-- SÍNTESIS DE NOVEDAD -->

          <section class='sintesis-novedad'>
            <h2 class='titulo-seccion'>
              Síntesis de la novedad:
            </h2>

            <p class='texto'>
              {{novedad.sintesis}}
            </p>
          </section>

          <!-- BIENES -->

          <section class='bienes'>
            <h2 class='titulo-seccion'>
              Desglose de bienes con afectación estimada del caso:
            </h2>

            <ol class='lista-bienes'>
              {{#each bienesAfectados}}
                <li>
                  <div class='bien-fila'>
                    <span class='bien-descripcion'>
                      {{descripcion}}
                    </span>

                    <span class='bien-valor'>
                      {{valor}}
                    </span>
                  </div>
                </li>
              {{else}}
                <li class='sin-registros'>
                  Sin bienes registrados.
                </li>
              {{/each}}
            </ol>
          </section>

          <!-- MUESTRARIO FOTOGRÁFICO -->

          <section class='muestrario'>
            <h2 class='titulo-seccion'>
              Muestrario fotográfico del caso:
            </h2>

            <div class='fotografias'>
              {{#each fotografias}}
                <div class='fotografia'>
                  <div class='numero-fotografia'>
                    {{numero}}
                  </div>

                  {{#if imagen}}
                    <img src='{{{imagen}}}' alt='Fotografía {{numero}}' />
                  {{else}}
                    <div class='foto-vacia'>
                      Sin fotografía
                    </div>
                  {{/if}}
                </div>
              {{else}}
                <div class='sin-registros'>
                  No existen fotografías registradas.
                </div>
              {{/each}}
            </div>
          </section>

          <footer class='pie'>
            <div class='pie-linea'></div>

            <div class='pie-texto'>
              Fin de la transmisión
            </div>
          </footer>
        </article>
      </section>
    </main>
  </body>
</html>