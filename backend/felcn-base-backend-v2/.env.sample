# ============================================
# ENTORNO
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# CONFIG GLOBAL (fallback)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

DB_USE_SSL=false
DB_VERIFY_SSL=false

# ============================================
# AUTH (felcn_auth)
# ============================================
DB_AUTH_HOST=localhost
DB_AUTH_PORT=5432
DB_AUTH_USERNAME=postgres
DB_AUTH_PASSWORD=postgres
DB_AUTH_DATABASE=felcn_auth_v3

# ============================================
# ASIGNACIÓN DE CASOS
# ============================================
