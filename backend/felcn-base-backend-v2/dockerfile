# ----------- BUILD -----------
FROM node:22-alpine AS build
WORKDIR /home/node/app

COPY package*.json ./
RUN npm ci --prefer-offline --no-audit

COPY . .
RUN node --run build


# ----------- PROD DEPS -----------
FROM node:22-alpine AS prod-deps
WORKDIR /home/node/app

COPY package*.json ./
RUN npm ci --omit=dev --prefer-offline --no-audit


# ----------- FINAL -----------
FROM node:22-alpine AS app
WORKDIR /home/node/app

# Chromium + dependencias de fuentes para Puppeteer en Alpine
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-noto

# 👇 crear carpeta de logs con permisos correctos
RUN mkdir -p /tmp/logs && chown -R node:node /tmp/logs

# copiar solo lo necesario
COPY --from=prod-deps /home/node/app/node_modules ./node_modules
COPY --from=build /home/node/app/dist ./dist

# metadata (opcional)
ARG CI_COMMIT_SHORT_SHA
ARG CI_COMMIT_MESSAGE
ARG CI_COMMIT_REF_NAME

ENV CI_COMMIT_SHORT_SHA=$CI_COMMIT_SHORT_SHA \
    CI_COMMIT_MESSAGE=$CI_COMMIT_MESSAGE \
    CI_COMMIT_REF_NAME=$CI_COMMIT_REF_NAME \
    NODE_ENV=production \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# seguridad
USER node

EXPOSE 3000

# 👇 más limpio que usar sh -c
CMD ["node", "dist/src/main"]
