# ----------- BUILD -----------
FROM node:22-alpine AS build
WORKDIR /home/node/app

COPY package*.json ./
RUN npm ci --prefer-offline --no-audit

COPY . .
RUN node --run build


# ----------- PROD DEPS -----------
FROM node:22-alpine AS prod-deps
WORKDIR /home/node/app

COPY package*.json ./
RUN npm ci --omit=dev --prefer-offline --no-audit


# ----------- FINAL -----------
FROM node:22-slim AS app
WORKDIR /home/node/app

# Chromium para Puppeteer (Debian slim usa glibc — compatible con Chrome)
# Version fijada: chromium 150.x (bookworm-security) crashea con SIGILL en
# este host al iniciar; 147.x funciona. apt-mark hold evita que un rebuild
# futuro vuelva a traer una version rota via bookworm-security.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium=147.0.7727.137-1~deb12u1 \
    chromium-common=147.0.7727.137-1~deb12u1 \
    fonts-noto \
    fonts-freefont-ttf \
    ca-certificates \
    && apt-mark hold chromium chromium-common \
    && rm -rf /var/lib/apt/lists/*

# Puppeteer usará el Chromium del sistema
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    NODE_ENV=production

# Crear carpeta de logs con permisos correctos
RUN mkdir -p /tmp/logs && chown -R node:node /tmp/logs /home/node

# Copiar archivos
COPY --from=prod-deps /home/node/app/node_modules ./node_modules
COPY --from=build /home/node/app/dist ./dist
COPY --from=build /home/node/app/src ./src

# metadata (opcional)
ARG CI_COMMIT_SHORT_SHA
ARG CI_COMMIT_MESSAGE
ARG CI_COMMIT_REF_NAME

ENV CI_COMMIT_SHORT_SHA=$CI_COMMIT_SHORT_SHA \
    CI_COMMIT_MESSAGE=$CI_COMMIT_MESSAGE \
    CI_COMMIT_REF_NAME=$CI_COMMIT_REF_NAME

USER node

EXPOSE 3000

CMD ["node", "dist/src/main"]
