{
  "name": "felcn-base-backend",
  "version": "1.18.1-rc",
  "description": "Backend base con Nest.js, TypeORM y TypeScript",
  "author": "support@felcn.gob.bo",
  "private": true,
  "license": "LPG-Bolivia",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format-check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "setup": "npm run migrations:clean && npm run schema:drop && npm run migrations:generate database/migrations/init && npm run migrations:run && npm run seeds:run",
    "dev": "cross-env LOG_SQL=true LOG_CONSOLE=true LOG_LEVEL=debug npm run start:dev",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "db:create": "bash ./database/scripts/dbcreate_docker.sh",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "fix:eol": "node -e \"const{execSync}=require('child_process');execSync('find src test -name \\\"*.ts\\\" -exec sed -i \\\"s/\\\\r$//\\\" {} \\\\;',{stdio:'inherit'})\" && echo 'Line endings fixed to LF'",
    "test": "jest --verbose --coverage=false",
    "test:single": "cross-env NODE_ENV=test jest --coverage=false -i",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:debug": "cross-env NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json",
    "test:ci": "cross-env NODE_ENV=test jest --collectCoverage --ci --reporters=default --reporters=jest-junit --watchAll=false",
    "report-e2e:basic": "bash ./scripts/test/e2e-generate.sh",
    "report-e2e:extended": "bash ./scripts/test/e2e-generate-estandar.sh",
    "typeorm": "cross-env NODE_OPTIONS=--max_old_space_size=8192 ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migrations:clean": "rimraf database/migrations && node -e \"require('fs').mkdirSync('database/migrations', {recursive: true})\"",
    "migrations:generate": "npm run typeorm -- migration:generate -d ormconfig-default.ts",
    "migrations:run": "npm run typeorm -- migration:run -d ormconfig-default.ts",
    "migrations:revert": "npm run typeorm -- migration:revert -d ormconfig-default.ts",
    "seeds:create": "npm run typeorm -- migration:create",
    "seeds:run": "npm run typeorm -- migration:run -d ormconfig-seed.ts",
    "schema:drop": "npm run typeorm -- schema:drop -d ormconfig-default.ts",
    "rimraf": "./node_modules/rimraf/bin.js",
    "compodoc": "compodoc -p tsconfig.json -o --language es-ES --disableCoverage --hideGenerator",
    "db:diagram": "ts-node ./node_modules/.bin/typeorm-uml ormconfig-default.ts -d ormconfig-default.ts -d docs/ERD.png",
    "prepare": "husky",
    "prebuild": "check-node-version && rimraf dist && npm run lint",
    "presetup": "check-node-version",
    "prestart": "check-node-version",
    "prestart:dev": "check-node-version",
    "pretest": "check-node-version",
    "preinstall": "",
    "postinstall": "check-node-version",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@elartedelcodigo/check-node-version": "1.3.2",
    "@nestjs/axios": "3.1.3",
    "@nestjs/common": "10.4.20",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.20",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "8.1.1",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/typeorm": "10.0.2",
    "axios": "1.12.2",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cls-rtracer": "2.6.3",
    "connect-typeorm": "2.0.0",
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.18",
    "dotenv": "17.2.3",
    "ejs": "3.1.10",
    "exceljs": "^4.4.0",
    "express-list-endpoints": "7.1.1",
    "express-session": "1.18.2",
    "file-stream-rotator": "1.0.0",
    "file-type": "16.5.4",
    "flatted": "3.3.3",
    "handlebars": "^4.7.9",
    "helmet": "8.1.0",
    "html-to-pdfmake": "2.5.31",
    "husky": "9.1.7",
    "ip-address": "10.0.1",
    "jsdom": "25.0.1",
    "nanoid": "3.3.11",
    "nest-authz": "2.17.0",
    "openid-client": "5.7.1",
    "pako": "2.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pdfmake": "0.2.20",
    "pg": "8.16.3",
    "pino": "9.13.1",
    "pino-loki": "2.6.0",
    "puppeteer": "^24.39.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.34.5",
    "sql-formatter": "15.6.10",
    "typeorm": "0.3.27",
    "typeorm-adapter": "1.8.0",
    "uuid": "10.0.0",
    "zxcvbn-typescript": "5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@compodoc/compodoc": "1.1.31",
    "@golevelup/ts-jest": "0.7.0",
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.20",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/express-list-endpoints": "6.0.3",
    "@types/express-session": "1.18.2",
    "@types/html-to-pdfmake": "2.4.4",
    "@types/ip": "1.1.3",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.13",
    "@types/node": "24.7.2",
    "@types/pako": "2.0.4",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pdfmake": "0.2.11",
    "@types/supertest": "6.0.3",
    "@types/uuid": "10.0.0",
    "@types/zxcvbn": "4.4.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "commit-and-tag-version": "12.6.0",
    "cross-env": "^10.1.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "jest-sonar-reporter": "2.0.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageReporters": [
      "html",
      "text",
      "text-summary",
      "cobertura"
    ],
    "coveragePathIgnorePatterns": [
      "src/main.ts",
      "src/database/migrations/",
      "src/database/seeds/",
      ".module.ts",
      ".entity.ts",
      ".dto.ts",
      ".guard.ts",
      ".enum.ts"
    ],
    "collectCoverage": true,
    "testResultsProcessor": "jest-sonar-reporter",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../src/$1"
    }
  },
  "jest-junit": {
    "outputDirectory": "./coverage"
  },
  "engines": {
    "node": "^22",
    "npm": ">=10"
  },
  "overrides": {
    "tmp": "0.2.4",
    "@nestjs/serve-static": {
      "path-to-regexp": "1.9.0"
    }
  }
}
