# Datos de despliegue development | test | production
NODE_ENV=development
PORT=4000

# Contraseña del usuario Admin (y de los demás usuarios sembrados) que crea
# `npm run seeds:run`. Obligatoria en todos los ambientes — el seed falla si
# no está seteada o si no cumple el nivel mínimo de fortaleza. Nunca dejar un
# valor débil aquí ni commitear la contraseña real usada en un ambiente.
ADMIN_INITIAL_PASSWORD=__CONTRASENA_FUERTE__

# Configuración de la base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=felcn_auth_v3
DB_USE_SSL=false
DB_VERIFY_SSL=false

DB_SCHEMA=proyecto
DB_SCHEMA_USUARIO=usuario
DB_SCHEMA_PARAMETRO=parametro
DB_SCHEMA_FELCN=felcn_estructura

# Configuración general de la aplicación
PATH_SUBDOMAIN=api
REQUEST_TIMEOUT_IN_SECONDS=30

# Configuración para módulo de autenticación
JWT_SECRET=token
JWT_EXPIRES_IN=1h

REFRESH_TOKEN_NAME=jid
REFRESH_TOKEN_EXPIRES_IN=3600000
REFRESH_TOKEN_ROTATE_IN=900000
REFRESH_TOKEN_SECURE=false
REFRESH_TOKEN_DOMAIN=test.agetic.gob.bo
REFRESH_TOKEN_PATH=/
REFRESH_TOKEN_REVISIONS='*/5 * * * *'

# Configuración SMTP para envío de correos
# SMTP_ENABLED=false → los correos se imprimen en logs (útil en desarrollo sin cuenta SMTP)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=true  ← usar solo si el puerto es 465 (SSL directo)
SMTP_SECURE=false
SMTP_USER=__CUENTA_GMAIL__@gmail.com
# Para Gmail: generar App Password en https://myaccount.google.com/apppasswords
# Requiere 2FA activado. Cuando FELCN provea su SMTP, reemplazar las 4 vars anteriores.
SMTP_PASS=__APP_PASSWORD_16_CHARS__
SMTP_FROM="FELCN Sistema <__CUENTA_GMAIL__@gmail.com>"

# Configuración para el servicio SEGIP de IOP, si corresponde
IOP_SEGIP_URL=https://interoperabilidad.agetic.gob.bo/fake/segip
IOP_SEGIP_TOKEN=__TOKEN_INTEROPERABILIDAD__
IOP_SEGIP_CONTRASTACION_ENABLED=false

# Configuración para el servicio SIN de IOP, si corresponde
IOP_SIN_URL=https://interoperabilidad.agetic.gob.bo/fake/impuestos/v1
IOP_SIN_TOKEN=__TOKEN_INTEROPERABILIDAD__

# Configuración para la integracion de autenticación con Ciudadanía Digital
OIDC_ISSUER=https://account-idetest.agcs.agetic.gob.bo
OIDC_CLIENT_ID=__OIDC_CLIENT_ID__
OIDC_CLIENT_SECRET=__OIDC_CLIENT_SECRET__
OIDC_SCOPE=__OIDC_SCOPE__
OIDC_REDIRECT_URI=__OIDC_REDIRECT_URI__
OIDC_POST_LOGOUT_REDIRECT_URI=__OIDC_POST_LOGOUT_REDIRECT_URI__
# Solo para entorno con fake-ciudadania-api (desarrollo). Eliminar al pasar a producción.
# FAKE_CIUDADANIA_INTERNAL_URL=http://localhost:3001
SESSION_SECRET=__SESSION_SECRET__

# Configurar la URL del frontend
URL_FRONTEND=http://localhost:8080/

# Configuración para almacenamiento de archivos
STORAGE_NFS_PATH=/home/user/storage/

# Habilita el registro de logs
LOG_ENABLED=true

# Configura el registro de logs (trace, debug, info, warn, error)
LOG_LEVEL=info

# Logs de auditoria disponibles:
# - application
# - request
# - response
# - authentication
# - mensajeria
LOG_AUDIT='application request response authentication mensajeria'

# Habilita la impresión de logs por la consola (en PRODUCCIÓN colocar los valores: LOG_CONSOLE=false y LOG_SQL=false)
LOG_CONSOLE=true
LOG_SQL=true

# Para guardar logs en ficheros
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/tmp/logs/
LOG_FILE_SIZE=50M
LOG_FILE_INTERVAL=YM

# Para guardar logs en la nube con loki
LOG_LOKI_ENABLED=false
LOG_LOKI_URL=http://localhost:3100/
LOG_LOKI_USERNAME=
LOG_LOKI_PASSWORD=
LOG_LOKI_BATCHING=true
LOG_LOKI_BATCH_INTERVAL=5
