{
  "name": "fake-ciudadania-api",
  "version": "1.0.0",
  "description": "Fake Ciudadanía Digital OIDC Provider - para desarrollo mientras AGETIC habilita acceso completo",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "migration:run": "ts-node -r tsconfig-paths/register src/database/migration-runner.ts",
    "migration:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.20",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.20",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/typeorm": "10.0.2",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "4.21.2",
    "hbs": "4.2.0",
    "jose": "5.9.6",
    "nodemailer": "6.9.16",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.27",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/hbs": "4.0.4",
    "@types/node": "24.7.2",
    "@types/nodemailer": "6.4.17",
    "@types/uuid": "10.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
