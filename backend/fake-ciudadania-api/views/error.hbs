<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Ciudadanía Digital Bolivia</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            font-family: 'Poppins', sans-serif;
            background: #0a0a0a;
            color: #ffffff;
            height: 100%;
            width: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            position: relative;
        }

        /* LOGO HEADER */
        .logo-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 50px;
            justify-content: center;
        }

        /* CONTENEDOR PRINCIPAL */
        .main-container {
            background: #3a3a3a;
            border-radius: 16px;
            padding: 60px;
            max-width: 560px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
            text-align: center;
        }

        .error-icon {
            font-size: 52px;
            margin-bottom: 24px;
        }

        h1 {
            font-size: 24px;
            font-weight: 700;
            color: #ef9a9a;
            margin-bottom: 16px;
            letter-spacing: -0.5px;
        }

        .error-message {
            font-size: 14px;
            color: #cccccc;
            line-height: 1.7;
            margin-bottom: 12px;
        }

        .error-hint {
            font-size: 12px;
            color: #888888;
            line-height: 1.6;
            margin-bottom: 36px;
        }

        .btn-back {
            display: inline-block;
            padding: 14px 40px;
            background: #5ba3f5;
            color: #000000;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            font-family: 'Poppins', sans-serif;
            transition: background 0.3s ease;
            cursor: pointer;
            border: none;
        }

        .btn-back:hover {
            background: #90caf9;
        }

        /* PIE DE PÁGINA */
        .footer {
            position: fixed;
            bottom: 20px;
            left: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .footer-logo {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
        }

        .footer-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .footer-text {
            font-size: 12px;
            color: #888888;
            font-weight: 400;
        }

        @media (max-width: 600px) {
            .main-container { padding: 40px 24px; }
            h1 { font-size: 20px; }
            .footer { position: relative; margin-top: 32px; }
        }
    </style>
</head>
<body>

    <!-- LOGO HEADER -->
    <div class="logo-header">
        <img src="/public/img/logo-only-dark.svg" alt="Ciudadanía Digital" width="65" height="65">
        <img src="/public/img/texto-logo-dark.svg" alt="Ciudadanía Digital" width="135" height="57">
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="main-container">
        <div class="error-icon">⚠️</div>
        <h1>Sesión inválida o expirada</h1>
        <p class="error-message">{{mensaje}}</p>
        <p class="error-hint">Volvé al sistema e iniciá el proceso de autenticación nuevamente.</p>
        <button class="btn-back" onclick="history.back()">Volver</button>
    </div>

    <!-- PIE DE PÁGINA -->
    <div class="footer">
        <div class="footer-logo">
            <img src="/public/img/logo-estado.svg" alt="Estado Plurinacional de Bolivia">
        </div>
        <div class="footer-text">AGETIC {{year}}</div>
    </div>

</body>
</html>
