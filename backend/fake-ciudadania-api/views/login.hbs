<!DOCTYPE html>
<html lang="es-BO">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Identidad Digital — Iniciar sesión</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        /* ── Design tokens ── */
        :root {
            --bg:          oklch(0.18 0.005 270);
            --surface:     oklch(0.235 0.006 270);
            --surface-2:   oklch(0.275 0.007 270);
            --border:      oklch(0.34 0.008 270);
            --border-2:    oklch(0.42 0.012 270);
            --fg:          oklch(0.97 0.005 270);
            --fg-2:        oklch(0.82 0.008 270);
            --fg-3:        oklch(0.66 0.010 270);
            --fg-4:        oklch(0.52 0.012 270);
            --ok:          oklch(0.78 0.13 155);
            --warn:        oklch(0.82 0.13 80);
            --err:         oklch(0.72 0.18 25);
            --accent:      oklch(0.74 0.14 265);
            --accent-fg:   oklch(0.34 0.14 265);
            --accent-soft: oklch(0.30 0.06 265);
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            font-family: 'Inter', system-ui, sans-serif;
            font-size: 14px;
            line-height: 1.5;
            color: var(--fg);
            background: var(--bg);
            min-height: 100vh;
        }

        /* ── App shell ── */
        .app {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background:
                radial-gradient(ellipse 60% 40% at 20% 10%, oklch(0.30 0.06 265 / .18) 0%, transparent 70%),
                radial-gradient(ellipse 50% 35% at 80% 85%, oklch(0.30 0.06 265 / .12) 0%, transparent 65%),
                var(--bg);
        }

        /* ── Topbar ── */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 28px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .topbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .topbar-brand img { display: block; }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .lang-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border: 1px solid var(--border-2);
            border-radius: 999px;
            font-size: 12px;
            color: var(--fg-3);
            background: transparent;
            cursor: default;
            user-select: none;
        }

        .icon-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 1px solid var(--border-2);
            background: transparent;
            color: var(--fg-3);
            cursor: pointer;
            transition: background .15s, color .15s;
        }
        .icon-btn:hover { background: var(--surface-2); color: var(--fg); }
        .icon-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

        /* ── Stage ── */
        .stage {
            flex: 1;
            display: grid;
            place-items: center;
            padding: 28px 28px 40px;
        }

        /* ── Card ── */
        .card {
            width: min(940px, 100%);
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: linear-gradient(160deg, var(--surface) 0%, oklch(0.215 0.006 270) 100%);
            box-shadow: 0 1px 0 oklch(1 0 0 / .04) inset, 0 24px 60px -20px oklch(0 0 0 / .55);
            overflow: visible;
        }

        /* ── Columns ── */
        .col {
            padding: 32px 36px;
        }

        /* ── Separator ── */
        .sep {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            position: relative;
        }

        .sep::before {
            content: '';
            position: absolute;
            top: 0; bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 1px;
            background: var(--border);
        }

        .sep-label {
            position: relative;
            z-index: 1;
            background: oklch(0.225 0.006 270);
            padding: 8px 0;
            font-size: 11px;
            color: var(--fg-4);
            writing-mode: vertical-rl;
            letter-spacing: 0.1em;
            user-select: none;
        }

        /* ── Method tag ── */
        .method-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            background: var(--accent-soft);
            border-radius: 999px;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 12px;
        }

        /* ── Typography ── */
        h1 {
            font-size: 22px;
            font-weight: 600;
            letter-spacing: -0.01em;
            color: var(--fg);
            margin-bottom: 4px;
        }

        h2 {
            font-size: 18px;
            font-weight: 600;
            letter-spacing: -0.005em;
            color: var(--fg);
            margin-bottom: 4px;
        }

        .subtitle-client {
            font-size: 12.5px;
            color: var(--fg-3);
            margin-bottom: 4px;
        }

        /* ── Environment chip ── */
        .env-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11.5px;
            color: var(--warn);
            margin-bottom: 20px;
        }

        .env-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--warn);
            flex-shrink: 0;
        }

        /* ── Form ── */
        .field { margin-bottom: 16px; }

        .field-label {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 13px;
            font-weight: 500;
            color: var(--fg-2);
            margin-bottom: 5px;
        }

        .field-label label { cursor: pointer; }
        .field-label .req { color: var(--err); }

        .help-trigger {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 1.5px solid var(--fg-4);
            background: transparent;
            color: var(--fg-4);
            font-size: 10px;
            font-weight: 700;
            cursor: pointer;
            line-height: 1;
            transition: border-color .15s, color .15s;
            flex-shrink: 0;
        }
        .help-trigger:hover { border-color: var(--accent); color: var(--accent); }
        .help-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            background: oklch(0.20 0.005 270);
            border: 1px solid var(--border);
            border-radius: 10px;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }
        .input-wrap:focus-within {
            border-color: var(--accent);
            box-shadow: 0 0 0 4px oklch(0.74 0.14 265 / .18);
            background: oklch(0.22 0.005 270);
        }
        .input-wrap.has-error {
            border-color: var(--err);
            box-shadow: 0 0 0 4px oklch(0.72 0.18 25 / .15);
        }
        .input-wrap.is-valid { border-color: oklch(0.55 0.10 155); }

        .input-wrap input {
            flex: 1;
            height: 44px;
            padding: 0 12px;
            background: transparent;
            border: none;
            outline: none;
            color: var(--fg);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-feature-settings: "tnum";
        }
        .input-wrap input::placeholder { color: var(--fg-4); }

        .input-trail {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 7px;
            border: none;
            background: transparent;
            color: var(--fg-3);
            cursor: pointer;
            transition: background .15s, color .15s;
            flex-shrink: 0;
            margin-right: 5px;
        }
        .input-trail:hover { background: var(--surface-2); color: var(--fg); }
        .input-trail:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

        .field-msg {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            margin-top: 5px;
            color: var(--fg-3);
            min-height: 18px;
        }
        .field-msg.error { color: var(--err); }
        .field-msg.warn  { color: var(--warn); }
        .field-msg.ok    { color: var(--ok); }

        /* ── Trust device row ── */
        .trust-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        .trust-label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: 13px;
            color: var(--fg-2);
            user-select: none;
        }
        .trust-label input[type="checkbox"] { display: none; }

        .check-box {
            width: 16px;
            height: 16px;
            border-radius: 5px;
            border: 1.5px solid var(--border-2);
            background: oklch(0.20 0.005 270);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background .15s, border-color .15s;
        }
        .trust-label input:checked ~ .check-box {
            background: var(--accent);
            border-color: var(--accent);
        }
        .check-box .chk-icon { display: none; }
        .trust-label input:checked ~ .check-box .chk-icon { display: block; }

        .create-link {
            font-size: 12.5px;
            color: var(--accent);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .create-link:hover { filter: brightness(1.15); }

        /* ── Server error ── */
        .server-error {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px 14px;
            background: oklch(0.30 0.08 25 / .25);
            border: 1px solid oklch(0.72 0.18 25 / .5);
            border-left: 3px solid var(--err);
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 13px;
            color: var(--fg-2);
        }
        .server-error svg { flex-shrink: 0; margin-top: 2px; color: var(--err); }
        .server-error strong { display: block; color: var(--fg); font-weight: 600; margin-bottom: 2px; }

        /* ── Actions ── */
        .actions { display: flex; gap: 10px; }

        .btn {
            height: 44px;
            padding: 0 22px;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s, transform .1s, filter .15s, box-shadow .15s;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

        .btn-back {
            flex: 1;
            background: transparent;
            border: 1px solid var(--border-2);
            color: var(--fg-2);
        }
        .btn-back:hover { background: var(--surface-2); color: var(--fg); }

        .btn-primary {
            flex: 1;
            background: var(--accent);
            color: oklch(0.22 0.06 265);
            box-shadow: 0 1px 0 oklch(1 0 0 / .25) inset, 0 8px 24px -10px oklch(0.74 0.14 265 / .8);
        }
        .btn-primary:not(:disabled):hover {
            transform: translateY(-1px);
            filter: brightness(1.06);
        }
        .btn-primary:disabled {
            background: var(--surface-2);
            color: var(--fg-4);
            box-shadow: none;
            cursor: not-allowed;
        }

        @keyframes spin { to { transform: rotate(360deg); } }
        .spin { animation: spin 0.9s linear infinite; }

        /* ── QR column ── */
        .qr-col {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .qr-subtitle {
            font-size: 13px;
            color: var(--fg-3);
            margin-bottom: 20px;
            text-align: center;
        }

        .qr-frame {
            width: 240px;
            height: 240px;
            border-radius: 12px;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 12px 28px -12px oklch(0 0 0 / .55);
            position: relative;
            overflow: hidden;
            margin-bottom: 12px;
            flex-shrink: 0;
        }

        #qrcode canvas, #qrcode img { display: block; }

        .qr-expired-overlay {
            position: absolute;
            inset: 0;
            background: oklch(0 0 0 / .72);
            backdrop-filter: blur(4px);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-align: center;
            padding: 16px;
        }
        .qr-expired-overlay.visible { display: flex; }
        .qr-expired-overlay p { font-size: 13px; font-weight: 600; color: #fff; }

        .btn-refresh {
            padding: 6px 14px;
            border-radius: 8px;
            border: 1px solid var(--border-2);
            background: var(--surface-2);
            color: var(--fg);
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: background .15s;
        }
        .btn-refresh:hover { background: var(--surface); }
        .btn-refresh:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

        .qr-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--fg-3);
            margin-bottom: 20px;
        }

        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 oklch(0.78 0.13 155 / .6); }
            50%       { box-shadow: 0 0 0 6px oklch(0.78 0.13 155 / 0); }
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--ok);
            animation: pulse 1.6s ease-in-out infinite;
            flex-shrink: 0;
        }

        .qr-steps {
            list-style: none;
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 20px;
        }

        .qr-step {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 13px;
            color: var(--fg-3);
        }

        .step-num {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--accent-soft);
            color: var(--accent);
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .step-text strong { color: var(--fg-2); font-weight: 600; }

        .qr-cta {
            width: 100%;
            padding: 10px 14px;
            border: 1px dashed var(--border-2);
            border-radius: 8px;
            font-size: 12.5px;
            color: var(--fg-3);
            text-align: center;
        }
        .qr-cta a { color: var(--accent); text-decoration: none; font-weight: 600; }
        .qr-cta a:hover { filter: brightness(1.15); }

        /* ── Footer ── */
        .footer {
            padding: 16px 28px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-top: 1px solid var(--border);
            flex-shrink: 0;
        }

        .footer img { width: 40px; height: 40px; object-fit: contain; }

        .footer-text {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: var(--fg-4);
        }

        /* ── CI Popover ── */
        .popover-wrap { position: relative; display: inline-flex; }

        .popover {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            left: -8px;
            width: 360px;
            z-index: 600;
            background: var(--surface-2);
            border: 1px solid var(--border-2);
            border-radius: 12px;
            box-shadow: 0 18px 40px -12px oklch(0 0 0 / .7);
        }

        @keyframes popIn {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .popover.open {
            display: block;
            animation: popIn .14s ease-out;
        }

        .popover-arrow {
            position: absolute;
            top: -5px;
            left: 14px;
            width: 10px;
            height: 10px;
            background: var(--surface-2);
            border-left: 1px solid var(--border-2);
            border-top: 1px solid var(--border-2);
            transform: rotate(45deg);
        }

        .popover-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px 10px;
        }

        .popover-header h3 { font-size: 13px; font-weight: 600; color: var(--fg); }

        .popover-close {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: none;
            background: transparent;
            color: var(--fg-3);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            line-height: 1;
            transition: background .15s, color .15s;
        }
        .popover-close:hover { background: var(--surface); color: var(--fg); }

        .popover-diagram { padding: 0 16px 10px; }

        .popover-rules {
            padding: 0 16px 14px;
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .popover-rules li {
            font-size: 12.5px;
            color: var(--fg-3);
            display: flex;
            align-items: flex-start;
            gap: 7px;
            line-height: 1.5;
        }
        .popover-rules li::before {
            content: '•';
            color: var(--accent);
            font-size: 14px;
            line-height: 1.3;
            flex-shrink: 0;
        }
        .popover-rules li strong { color: var(--fg-2); font-weight: 600; }

        /* ── DEMO badge ── */
        .demo-badge {
            position: fixed;
            bottom: 15px;
            right: -23px;
            background: #b71c1c;
            color: #fff;
            font-family: system-ui, sans-serif;
            font-weight: bold;
            font-size: 12px;
            width: 100px;
            text-align: center;
            padding: 4px 0;
            transform: rotate(-45deg);
            z-index: 9999;
            pointer-events: none;
        }

        /* ── Responsive ── */
        @media (max-width: 820px) {
            .card {
                grid-template-columns: 1fr;
            }

            .sep {
                width: 100%;
                height: 36px;
                padding: 0;
            }

            .sep::before {
                top: 50%; bottom: auto;
                left: 0; right: 0;
                width: 100%;
                height: 1px;
                transform: none;
            }

            .sep-label {
                writing-mode: horizontal-tb;
                padding: 0 8px;
            }

            .col { padding: 24px; }

            .popover { width: min(360px, calc(100vw - 32px)); }

            .stage { padding: 16px 16px 32px; }
        }

        @media (max-width: 480px) {
            .topbar { padding: 14px 16px; }
            .footer { padding: 12px 16px; }
            h1 { font-size: 20px; }
            h2 { font-size: 16px; }
        }
    </style>
</head>
<body>
<div class="app">

    <!-- ── Topbar ── -->
    <header class="topbar">
        <div class="topbar-brand">
            <img src="/public/img/logo-only-dark.svg" alt="" width="32" height="32">
            <img src="/public/img/texto-logo-dark.svg" alt="Ciudadanía Digital" height="28" style="max-width:130px;object-fit:contain;">
        </div>
        <div class="topbar-actions">
            <div class="lang-pill">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                ES
            </div>
            <button class="icon-btn" id="helpBtn" aria-label="Ayuda">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            </button>
        </div>
    </header>

    <!-- ── Stage ── -->
    <main class="stage">
        <div class="card">

            <!-- LEFT: Credenciales -->
            <section class="col" aria-label="Acceso con credenciales">

                <div class="method-tag">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    ACCESO SEGURO
                </div>

                <h1>Inicia sesión</h1>

                {{#if clientName}}
                <p class="subtitle-client">{{clientName}}</p>
                {{/if}}

                <div class="env-chip" aria-label="Ambiente Developer">
                    <span class="env-dot"></span>
                    Ambiente · Developer
                </div>

                {{#if error}}
                <div class="server-error" role="alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <div>
                        <strong>No pudimos iniciar tu sesión.</strong>
                        {{error}}
                    </div>
                </div>
                {{/if}}

                <form id="loginForm" action="/interaction/{{uid}}/login" method="POST" novalidate autocomplete="on">

                    <!-- Campo CI -->
                    <div class="field">
                        <div class="field-label">
                            <label for="ciInput">Cédula de identidad <span class="req" aria-hidden="true">*</span></label>
                            <div class="popover-wrap">
                                <button
                                    type="button"
                                    class="help-trigger"
                                    id="ciHelpBtn"
                                    aria-expanded="false"
                                    aria-label="Ayuda: ¿dónde encuentro mi número de cédula?"
                                    aria-haspopup="dialog"
                                >?</button>
                                <div
                                    class="popover"
                                    id="ciPopover"
                                    role="dialog"
                                    aria-label="¿Dónde encuentro mi número de cédula?"
                                    aria-modal="true"
                                >
                                    <div class="popover-arrow"></div>
                                    <div class="popover-header">
                                        <h3>¿Dónde encuentro mi número?</h3>
                                        <button type="button" class="popover-close" id="ciPopoverClose" aria-label="Cerrar">✕</button>
                                    </div>
                                    <div class="popover-diagram">
                                        <!-- Diagrama genérico de cédula (no copia el diseño oficial del DNI) -->
                                        <svg width="100%" viewBox="0 0 328 130" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ilustración de cédula mostrando el número y el complemento">
                                            <rect x="1" y="1" width="326" height="128" rx="9" style="fill:oklch(0.235 0.006 270);stroke:oklch(0.42 0.012 270);stroke-width:1.5"/>
                                            <rect x="1" y="1" width="326" height="30" rx="9" style="fill:oklch(0.30 0.06 265 / .4)"/>
                                            <rect x="1" y="20" width="326" height="11" style="fill:oklch(0.30 0.06 265 / .4)"/>
                                            <!-- Photo placeholder -->
                                            <rect x="14" y="40" width="60" height="76" rx="5" style="fill:oklch(0.275 0.007 270);stroke:oklch(0.34 0.008 270)"/>
                                            <text x="44" y="83" font-size="10" text-anchor="middle" font-family="Inter, sans-serif" style="fill:oklch(0.52 0.012 270)">foto</text>
                                            <!-- Name lines -->
                                            <rect x="88" y="44" width="120" height="7" rx="3" style="fill:oklch(0.42 0.012 270)"/>
                                            <rect x="88" y="58" width="90" height="6" rx="3" style="fill:oklch(0.34 0.008 270)"/>
                                            <!-- CI label -->
                                            <text x="88" y="84" font-size="9" font-family="Inter, sans-serif" font-weight="500" style="fill:oklch(0.66 0.010 270)">N° DE CÉDULA</text>
                                            <!-- CI highlight box -->
                                            <rect x="86" y="88" width="148" height="24" rx="5" style="fill:oklch(0.30 0.06 265 / .3);stroke:oklch(0.74 0.14 265 / .7)"/>
                                            <!-- Number -->
                                            <text x="94" y="105" font-size="13" font-family="JetBrains Mono, monospace" font-weight="500" style="fill:#1a1a2e">5808569</text>
                                            <!-- Complement -->
                                            <text x="165" y="105" font-size="13" font-family="JetBrains Mono, monospace" font-weight="500" style="fill:oklch(0.74 0.14 265)">-A1</text>
                                            <!-- Annotation: Número -->
                                            <line x1="120" y1="88" x2="120" y2="74" stroke-dasharray="2,2" style="stroke:oklch(0.74 0.14 265 / .5);stroke-width:1"/>
                                            <text x="120" y="71" font-size="8.5" text-anchor="middle" font-family="Inter, sans-serif" style="fill:oklch(0.74 0.14 265)">Número</text>
                                            <!-- Annotation: Complemento -->
                                            <line x1="178" y1="88" x2="244" y2="68" stroke-dasharray="2,2" style="stroke:oklch(0.74 0.14 265 / .5);stroke-width:1"/>
                                            <text x="248" y="68" font-size="8.5" font-family="Inter, sans-serif" style="fill:oklch(0.74 0.14 265)">Complemento</text>
                                            <text x="248" y="79" font-size="8" font-family="Inter, sans-serif" style="fill:oklch(0.66 0.010 270)">(si aplica)</text>
                                        </svg>
                                    </div>
                                    <ul class="popover-rules">
                                        <li>Ingresa el número completo tal como aparece en tu carnet.</li>
                                        <li>Si tu cédula tiene <strong>un guion seguido de 2 caracteres</strong> (ej. -A1, -1K), agrégalos al final.</li>
                                        <li>La mayoría <strong>no tienen complemento</strong>. Solo aparece en casos especiales del SEGIP.</li>
                                        <li><strong>No incluyas</strong> la extensión (LP, CB, SC…) ni puntos.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="input-wrap" id="ciWrap">
                            <input
                                type="text"
                                id="ciInput"
                                name="login"
                                placeholder="Ej. 5808569 o 5808569-A1"
                                inputmode="numeric"
                                pattern="[0-9]*"
                                autocomplete="username"
                                maxlength="16"
                                aria-required="true"
                                aria-describedby="ciMsg"
                            >
                        </div>
                        <div class="field-msg" id="ciMsg" aria-live="polite"></div>
                    </div>

                    <!-- Campo Contraseña -->
                    <div class="field">
                        <div class="field-label">
                            <label for="pwdInput">Contraseña <span class="req" aria-hidden="true">*</span></label>
                        </div>
                        <div class="input-wrap" id="pwdWrap">
                            <input
                                type="password"
                                id="pwdInput"
                                name="password"
                                placeholder="Tu contraseña"
                                autocomplete="current-password"
                                aria-required="true"
                                aria-describedby="pwdMsg"
                            >
                            <button
                                type="button"
                                class="input-trail"
                                id="eyeBtn"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false"
                            >
                                <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <div class="field-msg" id="pwdMsg" aria-live="polite"></div>
                    </div>

                    <!-- Trust device + Crear cuenta -->
                    <div class="trust-row">
                        <label class="trust-label" for="trustDevice">
                            <input type="checkbox" id="trustDevice" name="trustDevice">
                            <span class="check-box">
                                <svg class="chk-icon" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1.5,6 4.5,9 10.5,3"/></svg>
                            </span>
                            Confiar en este dispositivo por 30 días
                        </label>
                        <a href="#" class="create-link">
                            Crear cuenta
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/></svg>
                        </a>
                    </div>

                    <!-- Acciones -->
                    <div class="actions">
                        <button type="button" class="btn btn-back" id="backBtn">Volver</button>
                        <button type="submit" class="btn btn-primary" id="submitBtn" disabled aria-busy="false">Ingresar</button>
                    </div>

                </form>
            </section>

            <!-- SEPARADOR -->
            <div class="sep" aria-hidden="true">
                <span class="sep-label">·o·</span>
            </div>

            <!-- RIGHT: QR -->
            <section class="col qr-col" aria-label="Acceso por código QR">

                <div class="method-tag">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                    SIN CONTRASEÑA
                </div>

                <h2>Escanea con tu teléfono</h2>
                <p class="qr-subtitle">Más rápido y sin teclear contraseñas.</p>

                <div class="qr-frame" role="img" aria-label="Código QR para iniciar sesión desde la app móvil">
                    <div id="qrcode"></div>
                    <div class="qr-expired-overlay" id="qrExpiredOverlay" role="status">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:oklch(0.72 0.18 25)" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <p>El código expiró</p>
                        <button type="button" class="btn-refresh" id="qrRefreshBtn">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                            Generar otro
                        </button>
                    </div>
                </div>

                <div class="qr-status" role="status" aria-live="polite">
                    <span class="pulse-dot" id="qrDot" aria-hidden="true"></span>
                    <span>Esperando tu teléfono · expira en <strong id="qrTimer">01:30</strong></span>
                </div>

                <ol class="qr-steps" aria-label="Pasos para usar el QR">
                    <li class="qr-step">
                        <span class="step-num" aria-hidden="true">1</span>
                        <span class="step-text">Abre la app <strong>Identidad Digital</strong>.</span>
                    </li>
                    <li class="qr-step">
                        <span class="step-num" aria-hidden="true">2</span>
                        <span class="step-text">Toca <strong>Escanear QR</strong> en el menú principal.</span>
                    </li>
                    <li class="qr-step">
                        <span class="step-num" aria-hidden="true">3</span>
                        <span class="step-text">Apunta a esta imagen para entrar.</span>
                    </li>
                </ol>

                <div class="qr-cta">
                    ¿Aún no tienes la app? <a href="#">Descárgala aquí</a>
                </div>

            </section>

        </div>
    </main>

    <!-- ── Footer ── -->
    <footer class="footer">
        <img src="/public/img/logo-estado.svg" alt="Estado Plurinacional de Bolivia" width="40" height="40">
        <span class="footer-text">AGETIC {{year}}</span>
    </footer>

</div>

<!-- DEMO badge -->
<div class="demo-badge" aria-hidden="true">DEMO</div>

<script>
(function () {
    'use strict';

    // ── QR countdown ──
    var QR_TTL = 90;
    var qrSeconds = QR_TTL;
    var qrInterval = null;
    var qrEl = document.getElementById('qrcode');
    var qrTimerEl = document.getElementById('qrTimer');
    var qrDot = document.getElementById('qrDot');
    var qrExpiredOverlay = document.getElementById('qrExpiredOverlay');

    function pad(n) { return n < 10 ? '0' + n : String(n); }

    function buildQR() {
        qrEl.innerHTML = '';
        new QRCode(qrEl, {
            text: window.location.href,
            width: 200,
            height: 200,
            colorDark: '#000000',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M
        });
    }

    function startCountdown() {
        qrSeconds = QR_TTL;
        qrExpiredOverlay.classList.remove('visible');
        qrDot.style.display = '';
        clearInterval(qrInterval);
        qrTimerEl.textContent = '01:30';
        qrInterval = setInterval(function () {
            qrSeconds--;
            var m = Math.floor(qrSeconds / 60);
            var s = qrSeconds % 60;
            qrTimerEl.textContent = pad(m) + ':' + pad(s);
            if (qrSeconds <= 0) {
                clearInterval(qrInterval);
                qrDot.style.display = 'none';
                qrExpiredOverlay.classList.add('visible');
            }
        }, 1000);
    }

    document.getElementById('qrRefreshBtn').addEventListener('click', function () {
        buildQR();
        startCountdown();
    });

    // ── CI validation ──
    var CI_PATTERN = /^(\d{5,10})(?:-([A-Za-z0-9]{2}))?$/;
    var ciInput = document.getElementById('ciInput');
    var ciWrap  = document.getElementById('ciWrap');
    var ciMsg   = document.getElementById('ciMsg');
    var ciTouched = false;
    var ciValid   = false;

    function validateCI() {
        var val = ciInput.value.trim();
        if (!val) {
            ciWrap.classList.remove('has-error', 'is-valid');
            ciMsg.className = 'field-msg';
            ciMsg.textContent = '';
            ciInput.removeAttribute('aria-invalid');
            ciValid = false;
            checkSubmit();
            return;
        }
        var match = CI_PATTERN.exec(val);
        if (!match) {
            ciWrap.classList.add('has-error');
            ciWrap.classList.remove('is-valid');
            ciMsg.className = 'field-msg error';
            ciMsg.textContent = 'Formato no válido. Usa 5–10 dígitos y, si tu cédula lo tiene, agrega el complemento (ej. 5808569-A1).';
            ciInput.setAttribute('aria-invalid', 'true');
            ciValid = false;
        } else {
            ciWrap.classList.remove('has-error');
            ciWrap.classList.add('is-valid');
            ciInput.setAttribute('aria-invalid', 'false');
            if (match[2]) {
                ciMsg.className = 'field-msg ok';
                ciMsg.textContent = '✓ Incluye complemento ' + match[2].toUpperCase() + ' — solo si aparece en tu cédula.';
            } else {
                ciMsg.className = 'field-msg';
                ciMsg.textContent = 'Ej. 5808569 o, si tu cédula tiene complemento, 5808569-A1.';
            }
            ciValid = true;
        }
        checkSubmit();
    }

    ciInput.addEventListener('blur', function () {
        ciTouched = true;
        validateCI();
    });
    ciInput.addEventListener('input', function () {
        if (ciTouched) validateCI();
        else checkSubmit();
    });

    // ── Password ──
    var pwdInput = document.getElementById('pwdInput');
    var pwdMsg   = document.getElementById('pwdMsg');
    var eyeBtn   = document.getElementById('eyeBtn');
    var capsOn   = false;

    var SVG_EYE = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
    var SVG_EYE_OFF = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';

    eyeBtn.addEventListener('click', function () {
        var show = pwdInput.type === 'password';
        pwdInput.type = show ? 'text' : 'password';
        eyeBtn.setAttribute('aria-pressed', show ? 'true' : 'false');
        eyeBtn.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
        eyeBtn.innerHTML = show ? SVG_EYE_OFF : SVG_EYE;
        pwdInput.focus();
    });

    function updatePwdMsg() {
        if (capsOn) {
            pwdMsg.className = 'field-msg warn';
            pwdMsg.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg> Bloq. mayús. está activado.';
        } else {
            pwdMsg.className = 'field-msg';
            pwdMsg.textContent = '';
        }
    }

    pwdInput.addEventListener('input', function () { checkSubmit(); });
    pwdInput.addEventListener('keydown', function (e) {
        capsOn = e.getModifierState('CapsLock');
        updatePwdMsg();
    });
    pwdInput.addEventListener('keyup', function (e) {
        capsOn = e.getModifierState('CapsLock');
        updatePwdMsg();
    });

    // ── Submit state ──
    var submitBtn = document.getElementById('submitBtn');

    function checkSubmit() {
        var hasCI  = ciInput.value.trim().length > 0;
        var hasPwd = pwdInput.value.length > 0;
        submitBtn.disabled = !(hasCI && hasPwd);
    }

    // ── Popover CI ──
    var ciHelpBtn     = document.getElementById('ciHelpBtn');
    var ciPopover     = document.getElementById('ciPopover');
    var ciPopoverClose = document.getElementById('ciPopoverClose');

    function openPopover() {
        ciPopover.classList.add('open');
        ciHelpBtn.setAttribute('aria-expanded', 'true');
        ciPopoverClose.focus();
    }
    function closePopover() {
        ciPopover.classList.remove('open');
        ciHelpBtn.setAttribute('aria-expanded', 'false');
        ciHelpBtn.focus();
    }

    ciHelpBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        ciPopover.classList.contains('open') ? closePopover() : openPopover();
    });
    ciPopoverClose.addEventListener('click', closePopover);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && ciPopover.classList.contains('open')) closePopover();
    });
    document.addEventListener('click', function (e) {
        if (ciPopover.classList.contains('open') && !ciPopover.contains(e.target) && e.target !== ciHelpBtn) {
            closePopover();
        }
    });

    // ── Back button ──
    document.getElementById('backBtn').addEventListener('click', function (e) {
        e.preventDefault();
        history.back();
    });

    // ── Submit: spinner ──
    document.getElementById('loginForm').addEventListener('submit', function () {
        submitBtn.setAttribute('aria-busy', 'true');
        submitBtn.innerHTML = '<svg class="spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Verificando…';
        submitBtn.disabled = true;
    });

    // ── Topbar help ──
    document.getElementById('helpBtn').addEventListener('click', function () {
        alert('Ciudadanía Digital — Plataforma de autenticación del Estado Plurinacional de Bolivia (AGETIC).\n\nSi tienes problemas para ingresar, contacta a soporte técnico.');
    });

    // ── Init ──
    buildQR();
    startCountdown();
    checkSubmit();
})();
</script>

</body>
</html>
