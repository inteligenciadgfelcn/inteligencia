# NEXT_PUBLIC_APP_ENV: development | test | production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_NAME="FELCN"
NEXT_PUBLIC_PATH=""

# URLs de los backends — deben coincidir con la configuración de Nginx
NEXT_PUBLIC_BASE_URL="https://<DOMINIO>/felcn/api"
NEXT_PUBLIC_AUTH_URL="https://<DOMINIO>/felcn/auth/api"

# Ciudadanía Digital
NEXT_PUBLIC_CIUDADANIA_URL="<CIUDADANIA_URL>"

# Firmador digital
NEXT_PUBLIC_FIRMADOR_URL="https://localhost:4637"

# OpenStreetMap — usar instancia propia en producción
NEXT_PUBLIC_NOMINATIM_URL="https://nominatim.openstreetmap.org"

# Cookies seguras: true en producción (HTTPS), false en desarrollo
NEXT_PUBLIC_COOKIE_SECURE=true

# Dominios de imágenes permitidos (separados por coma)
NEXT_PUBLIC_IMAGES_DOMAIN="<DOMINIO>"

# Matomo (analíticas) — opcional
#NEXT_PUBLIC_MATOMO_URL=""
#NEXT_PUBLIC_MATOMO_SITE_ID=""
