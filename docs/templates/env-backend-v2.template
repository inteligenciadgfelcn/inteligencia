# ============================================
# ENTORNO
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# CONFIG GLOBAL (fallback)
# ============================================
DB_HOST=<DB_HOST>
DB_PORT=5432
DB_USERNAME=<DB_USERNAME>
DB_PASSWORD=<DB_PASSWORD>
DB_USE_SSL=false
DB_VERIFY_SSL=false

# ============================================
# AUTH (felcn_auth_v3)
# ============================================
DB_AUTH_HOST=<DB_HOST>
DB_AUTH_PORT=5432
DB_AUTH_USERNAME=<DB_USERNAME>
DB_AUTH_PASSWORD=<DB_PASSWORD>
DB_AUTH_DATABASE=felcn_auth_v3

# ============================================
# ASIGNACIÓN DE CASOS
# ============================================
DB_ASIG_CASOS_HOST=<DB_HOST>
DB_ASIG_CASOS_PORT=5432
DB_ASIG_CASOS_USERNAME=<DB_USERNAME>
DB_ASIG_CASOS_PASSWORD=<DB_PASSWORD>
DB_ASIG_CASOS_DATABASE=a_felcn_asignacion_caso

# ============================================
# SII
# ============================================
DB_SII_HOST=<DB_HOST>
DB_SII_PORT=5432
DB_SII_USERNAME=<DB_USERNAME>
DB_SII_PASSWORD=<DB_PASSWORD>
DB_SII_DATABASE=a_felcn_sii

# ============================================
# SIII
# ============================================
DB_SIII_HOST=<DB_HOST>
DB_SIII_PORT=5432
DB_SIII_USERNAME=<DB_USERNAME>
DB_SIII_PASSWORD=<DB_PASSWORD>
DB_SIII_DATABASE=felcn_siii

# ============================================
# SOSPECHOSO
# ============================================
DB_SOSPECHOSO_HOST=<DB_HOST>
DB_SOSPECHOSO_PORT=5432
DB_SOSPECHOSO_USERNAME=<DB_USERNAME>
DB_SOSPECHOSO_PASSWORD=<DB_PASSWORD>
DB_SOSPECHOSO_DATABASE=a_felcn_sospechoso

# ============================================
# LOGS
# ============================================
LOG_SQL=true
LOG_ENABLED=true
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_AUDIT='application request response authentication mensajeria'
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/tmp/logs/
LOG_FILE_SIZE=50M
LOG_FILE_INTERVAL=YM

# En producción:
# LOG_CONSOLE=false
# LOG_SQL=false

# ============================================
# CONFIGURACIÓN DE APLICACIÓN
# ============================================
PATH_SUBDOMAIN=api
REQUEST_TIMEOUT_IN_SECONDS=30

# ============================================
# JWT — Generar con: openssl rand -hex 32
# ============================================
JWT_SECRET=<JWT_SECRET_256_BITS_HEX>
JWT_EXPIRES_IN=300000

REFRESH_TOKEN_NAME=jid
REFRESH_TOKEN_EXPIRES_IN=3600000
REFRESH_TOKEN_ROTATE_IN=900000
REFRESH_TOKEN_SECURE=false
# En producción: REFRESH_TOKEN_SECURE=true
REFRESH_TOKEN_DOMAIN=<DOMINIO>
REFRESH_TOKEN_PATH=/
REFRESH_TOKEN_REVISIONS='*/5 * * * *'

# ============================================
# MENSAJERÍA
# ============================================
MSJ_URL=<MSJ_URL>
MSJ_TOKEN=<MSJ_TOKEN>
MSJ_TIMEOUT_EN_SEGUNDOS=10

# ============================================
# INTEROPERABILIDAD (IOP)
# ============================================
IOP_SEGIP_URL=<IOP_SEGIP_URL>
IOP_SEGIP_TOKEN=<IOP_SEGIP_TOKEN>
IOP_SEGIP_CONTRASTACION_ENABLED=false

IOP_SIN_URL=<IOP_SIN_URL>
IOP_SIN_TOKEN=<IOP_SIN_TOKEN>

# ============================================
# CIUDADANÍA DIGITAL (OIDC)
# ============================================
OIDC_ISSUER=<OIDC_ISSUER>
OIDC_CLIENT_ID=<OIDC_CLIENT_ID>
OIDC_CLIENT_SECRET=<OIDC_CLIENT_SECRET>
OIDC_SCOPE=openid profile fecha_nacimiento email celular offline_access
OIDC_REDIRECT_URI=https://<DOMINIO>/login/ciudadania
OIDC_POST_LOGOUT_REDIRECT_URI=https://<DOMINIO>/login
OIDC_POST_FAILED_REDIRECT_URI=https://<DOMINIO>/loginCode
SESSION_SECRET=<SESSION_SECRET>

# ============================================
# FRONTEND Y ALMACENAMIENTO
# ============================================
URL_FRONTEND=https://<DOMINIO>/

STORAGE_NFS_PATH=/home/user/storage/

# ============================================
# LOKI (logs centralizados — opcional)
# ============================================
LOG_LOKI_ENABLED=false
LOG_LOKI_URL=http://localhost:3100/
LOG_LOKI_USERNAME=
LOG_LOKI_PASSWORD=
LOG_LOKI_BATCHING=true
LOG_LOKI_BATCH_INTERVAL=5

# ============================================
# LOOKUPS ESTÁTICOS SIII
# ============================================
LOOKUP_GENERO=1:Masculino,0:Femenino
LOOKUP_ESTADO_SUJETO=Principal Implicado,Aprehendido,Arrestado,LGI O Perdida de Dominio

# ============================================
# REPORTES
# ============================================
LOGO_REPORT=<LOGO_REPORT_BASE64_O_RUTA>
