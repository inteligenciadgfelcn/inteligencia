# Reverse proxy TLS para el Docker Registry — SOLO en el servidor dev nuevo (.23),
# donde vive el registry (decisión del usuario, 29/08/2026: registry simple,
# no Harbor, corriendo junto a las apps de dev).
#
# El registry (`registry:2`) valida el login (REGISTRY_AUTH=htpasswd) — nginx
# solo termina TLS y pasa el header Authorization tal cual, patrón estándar
# documentado por Docker para exponer un registry propio detrás de un proxy.
#
# Reemplazar <DOMINIO_REGISTRY> (ej. registry.sunesis-dev.felcn.gob.bo) antes de usar.

server {
    listen 443 ssl;
    listen [::]:443 ssl ipv6only=on;
    server_name <DOMINIO_REGISTRY>;

    ssl_certificate     /etc/letsencrypt/live/<DOMINIO_REGISTRY>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<DOMINIO_REGISTRY>/privkey.pem;
    # Ver la nota en conf.d/app.conf.template: no se incluyen los archivos del
    # plugin nginx de certbot, `certonly --webroot` no los genera.

    include /etc/nginx/snippets/security-headers.conf;

    # El protocolo de Docker Registry v2 sube capas de imagen grandes en
    # streaming — sin límite de tamaño de body y con transfer-encoding chunked.
    client_max_body_size 0;
    chunked_transfer_encoding on;

    location / {
        proxy_pass         http://registry:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 900s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name <DOMINIO_REGISTRY>;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
