# NEXT_PUBLIC_APP_ENV puede ser development, test, production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_NAME="Frontend base"
#NEXT_PUBLIC_PATH="proyectos-base/agetic-next-base-frontend"
NEXT_PUBLIC_PATH=""
# NEXT_PUBLIC_BASE_URL="https://boliviancode.cloud/unodc/api"
NEXT_PUBLIC_BASE_URL="http://localhost:3000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:4000/api"
# NEXT_PUBLIC_BASE_API_URL="http://localhost:3001/api"
#NEXT_PUBLIC_BASE_URL="https://proyecto-base.test.gtic.gob.bo/ws/api"
NEXT_PUBLIC_CIUDADANIA_URL="https://ciudadania-portal.agcs.agetic.gob.bo/"

# Matomo local
#NEXT_PUBLIC_MATOMO_URL=""
#NEXT_PUBLIC_MATOMO_SITE_ID=""

# Firmador
NEXT_PUBLIC_FIRMADOR_URL="https://localhost:4637"

# Motor de búsqueda de ubicaciones utilizado en OpenStreetMap. Se recomienda utilizar tu propia API de Nominatim. Ejemplo disponible en https://gitlab.agetic.gob.bo/agetic/agetic/proyectos-base/utilidades/nominatim
NEXT_PUBLIC_NOMINATIM_URL="https://nominatim.openstreetmap.org"

# Configuración para marcar como segura la cookie guardada: secure = true | false
NEXT_PUBLIC_COOKIE_SECURE=false

# Dominios de imágenes soportados por la aplicación (separados por coma)
NEXT_PUBLIC_IMAGES_DOMAIN="localhost"

# Servicio de consulta persona SEGIP (fake)
NEXT_PUBLIC_CONSULTA_PERSONA_URL="https://desarrollo.felcn.gob.bo/persona"
# Al ser NEXT_PUBLIC_* queda expuesta en el bundle JS del navegador — nunca
# poner aquí la clave real. Usar el valor real solo en el .env (no versionado).
NEXT_PUBLIC_CONSULTA_PERSONA_API_KEY="__CONSULTA_PERSONA_API_KEY__"

# Activa/desactiva de forma transparente la verificación de datos del ciudadano
# con el SEGIP en el alta/edición de usuario (botón "Verificar con SEGIP").
# Por defecto activada; poner en "false" para desactivarla sin tocar código.
NEXT_PUBLIC_SEGIP_VERIFICACION_ENABLED=true
