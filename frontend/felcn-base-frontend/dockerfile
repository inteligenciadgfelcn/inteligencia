FROM hub.agcs.agetic.gob.bo/dockerhub-proxy/library/node:22-alpine AS build
WORKDIR /home/node/app

COPY package*.json ./

RUN npm set registry https://registry.agcs.agetic.gob.bo/ && \
    npm set strict-ssl false && \
    npm ci --progress=false --no-audit --ignore-scripts --legacy-peer-deps

COPY . .

ARG NEXT_PUBLIC_PATH=""
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_PATH=${NEXT_PUBLIC_PATH}
RUN node --run build

FROM hub.agcs.agetic.gob.bo/dockerhub-proxy/library/node:22-alpine AS release
WORKDIR /home/node/app
RUN apk add --no-cache libc6-compat

# Pre-instalar sharp en directorio temporal ANTES de los COPY
# Esta capa queda cacheada y solo se re-ejecuta si cambia la versión de sharp
RUN npm i sharp@0.33.5 --prefix /tmp/sharp-pkg --progress=false --no-audit --legacy-peer-deps

COPY --chown=node:node ./public ./public
COPY --chown=node:node ./package.json ./package.json
COPY --chown=node:node ./next.config.js ./next.config.js

COPY --from=build --chown=node:node /home/node/app/.next/standalone ./
COPY --from=build --chown=node:node /home/node/app/.next/static ./.next/static

# Reemplazar el sharp del standalone (instalado con --ignore-scripts, sin binario nativo)
# por el pre-instalado en /tmp (con binario nativo correcto)
RUN rm -rf ./node_modules/sharp ./node_modules/@img && \
    cp -r /tmp/sharp-pkg/node_modules/sharp ./node_modules/ && \
    cp -r /tmp/sharp-pkg/node_modules/@img ./node_modules/ 2>/dev/null || true && \
    chown -R node:node ./node_modules/sharp && \
    chown -R node:node ./node_modules/@img 2>/dev/null || true

ARG CI_COMMIT_SHORT_SHA
ARG CI_COMMIT_MESSAGE
ARG CI_COMMIT_REF_NAME
ENV CI_COMMIT_SHORT_SHA=${CI_COMMIT_SHORT_SHA} \
    CI_COMMIT_MESSAGE=${CI_COMMIT_MESSAGE} \
    CI_COMMIT_REF_NAME=${CI_COMMIT_REF_NAME}

FROM release AS app
USER node
CMD ["node", "server.js"]
EXPOSE 3000
